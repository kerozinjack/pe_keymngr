@page "/rooms/create"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Models
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@attribute [Authorize(Policy = "CanAccessAdminPages")]
@rendermode InteractiveServer

<PageTitle>Új terem létrehozása</PageTitle>

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3 mb-1">Új terem létrehozása</h1>
        <p class="text-muted mb-0">Add meg az új terem adatait és válaszd ki a hozzá tartozó felszereléseket.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">
            <div class="card shadow-sm">
                <div class="card-header bg-light py-3">
                    <h2 class="h5 mb-0">Terem adatai</h2>
                </div>

                <div class="card-body p-4">
                    <EditForm method="post" Model="Room" OnValidSubmit="AddRoom" FormName="create" Enhance>
                        <DataAnnotationsValidator />

                        <div class="mb-4">
                            <div class="mb-3">
                                <label for="roomname" class="form-label fw-semibold">Terem neve</label>
                                <InputText id="roomname" @bind-Value="Room.RoomName" class="form-control" placeholder="Pl. Előadóterem I0" />
                                <ValidationMessage For="() => Room.RoomName" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label for="building" class="form-label fw-semibold">Épület</label>
                                <InputText id="building" @bind-Value="Room.Building" class="form-control" placeholder="Pl. I" />
                                <ValidationMessage For="() => Room.Building" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label for="floor" class="form-label fw-semibold">Emelet</label>
                                <InputText id="floor" @bind-Value="Room.Floor" class="form-control" placeholder="Pl. Földszint vagy I" />
                                <ValidationMessage For="() => Room.Floor" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label for="capacity" class="form-label fw-semibold">Férőhelyek száma</label>
                                <InputNumber id="capacity" @bind-Value="Room.Capacity" class="form-control" placeholder="Pl. 30" />
                                <ValidationMessage For="() => Room.Capacity" class="text-danger small" />
                            </div>
                        </div>

                        <div class="border-top pt-4 mb-4">
                            <h2 class="h5 mb-2">Felszerelések</h2>
                            <p class="text-muted small mb-3">
                                Jelöld be azokat az eszközöket, amelyek a teremhez tartoznak.
                            </p>

                            <div class="row g-2">
                                @foreach (KeyValuePair<Guid, string> kvp in GetEquipments())
                                {
                                    <div class="col-12 col-sm-6">
                                        <div class="form-check border rounded p-3 ps-5 h-100">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   id="@kvp.Key"
                                                   @onchange="args => ToggleEquipment(kvp.Key, args)" />
                                            <label class="form-check-label" for="@kvp.Key">
                                                @kvp.Value
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <ValidationSummary class="text-danger mb-3" role="alert" />

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-3 border-top">
                            <a href="/rooms" class="btn btn-outline-secondary">
                                Vissza a termekhez
                            </a>

                            <button type="submit" class="btn btn-primary px-4">
                                Terem létrehozása
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private Room Room { get; set; } = default!;
    private List<Equipment> Equipments { get; set; } = [];

    private void ToggleEquipment(Guid id, ChangeEventArgs args)
    {
        using var context = DbFactory.CreateDbContext();
        Equipment? eq = context.Equipments.FirstOrDefault(e => e.EquipmentId == id);
        if (eq is null)
        {
            return;
        }
        if (args.Value is bool and true)
        {
            if (!Equipments.Contains(eq))
            {
                Equipments.Add(eq);
            }
        }
        else
        {
            Equipments = Equipments.FindAll(e=>e.EquipmentId != eq.EquipmentId);
        }
    }

    protected override void OnInitialized() => Room ??= new();

    private Dictionary<Guid, string> GetEquipments()
    {
        using var context = DbFactory.CreateDbContext();
        return context.Equipments.ToDictionary(k => k.EquipmentId, v => v.EquipmentName);
    }

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddRoom()
    {
        using var context = DbFactory.CreateDbContext();
        foreach (Equipment equipment in Equipments)
        {
            context.Attach(equipment).State = EntityState.Unchanged;
            Room.Equipments.Add(equipment);
        }
        context.Rooms.Add(Room);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/rooms");
    }
}