@page "/rooms"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using PeKeyMngr.Models
@using PeKeyMngr.Data
@implements IAsyncDisposable
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory

@attribute [Authorize(Policy = "CanAccessAdminPages")]

<PageTitle>Termek kezelése</PageTitle>

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Termek kezelése</h1>
            <p class="text-muted mb-0">Az épület termeinek és felszereltségének áttekintése.</p>
        </div>

        <a class="btn btn-primary" href="rooms/create">
            <i class="bi bi-plus-lg me-2"></i>
            Új terem
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-light py-3">
            <h2 class="h5 mb-0">Nyilvántartott termek</h2>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <QuickGrid Class="table table-hover align-middle mb-0" Items="context.Rooms">
                    <PropertyColumn Property="room => room.RoomName" Title="Terem neve" />
                    <PropertyColumn Property="room => room.Building" Title="Épület" />
                    <PropertyColumn Property="room => room.Floor" Title="Emelet" />
                    <PropertyColumn Property="room => room.Capacity" Title="Férőhely" />

                    <TemplateColumn Title="Felszereltség" Context="room">
                        <span class="text-muted small">
                            @GetEquipsments(room.RoomId)
                        </span>
                    </TemplateColumn>

                    <TemplateColumn Title="Műveletek" Context="room">
                        <div class="d-flex flex-wrap gap-2">
                            <a class="btn btn-sm btn-outline-primary"
                               href="@($"rooms/edit?roomid={room.RoomId}")">
                                Szerkesztés
                            </a>
                            <a class="btn btn-sm btn-outline-secondary"
                               href="@($"rooms/details?roomid={room.RoomId}")">
                                Részletek
                            </a>
                            <a class="btn btn-sm btn-outline-danger"
                               href="@($"rooms/delete?roomid={room.RoomId}")">
                                Törlés
                            </a>
                        </div>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>
    </div>
</div>

@code {
    private ApplicationDbContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public string GetEquipsments(Guid roomId)
    {
        using var context = DbFactory.CreateDbContext();
        Room? r = context.Rooms.Include(r=>r.Equipments).FirstOrDefault(r => r.RoomId == roomId);
        if (r is null || r.Equipments.Count == 0)
        {
            return "Nincs eszköz";
        }

        return string.Join(", ", r.Equipments.Select(e => e.EquipmentName)).TrimEnd();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}