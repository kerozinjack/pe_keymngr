@page "/rooms/delete"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Models
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@attribute [Authorize(Policy = "CanAccessAdminPages")]

<PageTitle>Terem törlése</PageTitle>

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3 mb-1">Terem törlése</h1>
        <p class="text-muted mb-0">Ellenőrizd a terem adatait a törlés előtt.</p>
    </div>

    @if (room is null)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <div class="spinner-border text-primary mb-3" role="status">
                    <span class="visually-hidden">Betöltés...</span>
                </div>
                <p class="text-muted mb-0">A terem adatainak betöltése...</p>
            </div>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8 col-xl-7">
                <div class="card shadow-sm">
                    <div class="card-header bg-light py-3">
                        <h2 class="h5 mb-0">Törlendő terem adatai</h2>
                    </div>

                    <div class="card-body p-4">
                        <div class="alert alert-warning d-flex align-items-center gap-2" role="alert">
                            <strong>Figyelem!</strong>
                            <span>Biztosan törölni szeretné ezt a termet? A művelet nem vonható vissza.</span>
                        </div>

                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted mb-2">Terem neve</dt>
                            <dd class="col-sm-8 mb-3 fw-medium">@room.RoomName</dd>

                            <dt class="col-sm-4 text-muted mb-2">Épület</dt>
                            <dd class="col-sm-8 mb-3">@room.Building</dd>

                            <dt class="col-sm-4 text-muted mb-2">Emelet</dt>
                            <dd class="col-sm-8 mb-3">@room.Floor</dd>

                            <dt class="col-sm-4 text-muted mb-2">Férőhelyek száma</dt>
                            <dd class="col-sm-8 mb-0">@room.Capacity</dd>
                        </dl>
                    </div>

                    <div class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                        <a href="/rooms" class="btn btn-outline-secondary">
                            Mégsem
                        </a>

                        <EditForm method="post" Model="room" OnValidSubmit="DeleteRoom" FormName="delete" Enhance>
                            <button type="submit" class="btn btn-danger" disabled="@(room is null)">
                                Terem törlése
                            </button>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private Room? room;

    [SupplyParameterFromQuery]
    private Guid RoomId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        room = await context.Rooms.FirstOrDefaultAsync(m => m.RoomId == RoomId);

        if (room is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteRoom()
    {
        using var context = DbFactory.CreateDbContext();
        context.Rooms.Remove(room!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/rooms");
    }
}