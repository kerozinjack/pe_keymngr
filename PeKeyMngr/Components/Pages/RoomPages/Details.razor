@page "/rooms/details"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Models
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@attribute [Authorize(Policy = "CanAccessAdminPages")]

<PageTitle>Terem adatai</PageTitle>

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3 mb-1">Terem adatai</h1>
        <p class="text-muted mb-0">A kiválasztott terem részletes adatai.</p>
    </div>

    @if (room is null)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <div class="spinner-border text-primary mb-3" role="status">
                    <span class="visually-hidden">Betöltés...</span>
                </div>
                <p class="text-muted mb-0">A terem adatainak betöltése...</p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header bg-light py-3">
                <h2 class="h5 mb-0">Terem információi</h2>
            </div>

            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-3 text-muted mb-2">Terem neve</dt>
                    <dd class="col-sm-9 mb-3 fw-medium">@room.RoomName</dd>

                    <dt class="col-sm-3 text-muted mb-2">Épület</dt>
                    <dd class="col-sm-9 mb-3">@room.Building</dd>

                    <dt class="col-sm-3 text-muted mb-2">Emelet</dt>
                    <dd class="col-sm-9 mb-3">@room.Floor</dd>

                    <dt class="col-sm-3 text-muted mb-2">Férőhelyek száma</dt>
                    <dd class="col-sm-9 mb-3">@room.Capacity</dd>

                    <dt class="col-sm-3 text-muted mb-2">Felszerelések</dt>
                    <dd class="col-sm-9 mb-0">
                        @if (room.Equipments.Any())
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var equipment in room.Equipments)
                                {
                                    <span class="badge bg-light text-dark border fw-normal">
                                        @equipment.EquipmentName
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">Nincs hozzárendelt felszerelés.</span>
                        }
                    </dd>
                </dl>
            </div>

            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                <a href="/rooms" class="btn btn-outline-secondary">
                    Vissza a termekhez
                </a>

                <a href="@($"/rooms/edit?roomid={room.RoomId}")" class="btn btn-primary">
                    Szerkesztés
                </a>
            </div>
        </div>
    }
</div>

@code {
    private Room? room;

    [SupplyParameterFromQuery]
    private Guid RoomId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        room = await context.Rooms.Include(r=>r.Equipments).FirstOrDefaultAsync(m => m.RoomId == RoomId);

        if (room is null)
        {
            NavigationManager.NotFound();
        }
    }
}