@page "/equipment/create"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Models
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@attribute [Authorize(Policy = "CanAccessAdminPages")]

<PageTitle>Új felszerelés</PageTitle>

<div class="container py-4">
    <div class="mb-4">
        <h3 class="mb-1">Új felszerelés hozzáadása</h3>
        <p class="text-muted mb-0">Új felszerelés felvétele a rendszer nyilvántartásába.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-light py-3">
                    <h5 class="mb-0">Felszerelés adatai</h5>
                </div>

                <div class="card-body">
                    <EditForm method="post" Model="Equipment" OnValidSubmit="AddEquipment" FormName="create" Enhance>
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" role="alert" />

                        <div class="mb-3">
                            <label for="equipmentname" class="form-label">Felszerelés neve</label>
                            <InputText id="equipmentname" @bind-Value="Equipment.EquipmentName" class="form-control" />
                            <ValidationMessage For="() => Equipment.EquipmentName" class="text-danger" />
                        </div>

                        <div class="d-flex justify-content-between gap-2 mt-4">
                            <a href="/equipment" class="btn btn-outline-secondary">Vissza a listához</a>
                            <button type="submit" class="btn btn-primary">Felszerelés létrehozása</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private Equipment Equipment { get; set; } = default!;

    protected override void OnInitialized() => Equipment ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddEquipment()
    {
        using var context = DbFactory.CreateDbContext();
        context.Equipments.Add(Equipment);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/equipment");
    }
}