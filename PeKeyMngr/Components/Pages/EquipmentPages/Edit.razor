@page "/equipment/edit"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Models
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@attribute [Authorize(Policy = "CanAccessAdminPages")]

<PageTitle>Felszerelés szerkesztése</PageTitle>

<div class="container py-4">
    <div class="mb-4">
        <h3 class="mb-1">Felszerelés szerkesztése</h3>
        <p class="text-muted mb-0">A kiválasztott felszerelés adatainak módosítása.</p>
    </div>

    @if (Equipment is null)
    {
        <p><em>Betöltés...</em></p>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-light py-3">
                        <h5 class="mb-0">Felszerelés adatai</h5>
                    </div>

                    <div class="card-body">
                        <EditForm method="post" Model="Equipment" OnValidSubmit="UpdateEquipment" FormName="edit" Enhance>
                            <DataAnnotationsValidator />
                            <ValidationSummary role="alert" />
                            <input type="hidden" name="Equipment.EquipmentId" value="@Equipment.EquipmentId" />

                            <div class="mb-3">
                                <label for="equipmentname" class="form-label">Felszerelés neve</label>
                                <InputText id="equipmentname" @bind-Value="Equipment.EquipmentName" class="form-control" />
                                <ValidationMessage For="() => Equipment.EquipmentName" class="text-danger" />
                            </div>

                            <div class="d-flex justify-content-between gap-2 mt-4">
                                <a href="/equipment" class="btn btn-outline-secondary">Vissza a listához</a>
                                <button type="submit" class="btn btn-primary">Mentés</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    private Guid EquipmentId { get; set; }

    [SupplyParameterFromForm]
    private Equipment? Equipment { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Equipment ??= await context.Equipments.FirstOrDefaultAsync(m => m.EquipmentId == EquipmentId);

        if (Equipment is null)
        {
            NavigationManager.NotFound();
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateEquipment()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Equipment!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!EquipmentExists(Equipment!.EquipmentId))
            {
                NavigationManager.NotFound();
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/equipment");
    }

    private bool EquipmentExists(Guid equipmentid)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Equipments.Any(e => e.EquipmentId == equipmentid);
    }
}