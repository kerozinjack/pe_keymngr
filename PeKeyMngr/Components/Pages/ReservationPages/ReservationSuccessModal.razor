@if (IsOpen)
{
    <div class="reservation-modal-backdrop">
        <section class="reservation-success-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="reservation-success-title">
            <div class="reservation-success-icon" aria-hidden="true">✓</div>
            <h2 id="reservation-success-title">Sikeres foglalás</h2>
            <p class="text-muted">A foglalás rögzítése megtörtént.</p>

            <dl class="reservation-success-details">
                <dt>Terem</dt>
                <dd>@RoomName</dd>
                <dt>Időpont</dt>
                <dd>@Schedule</dd>
                <dt>Igényelt felszerelés</dt>
                <dd>@Equipment</dd>
            </dl>

            <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mt-4">
                <button type="button" class="btn btn-outline-secondary" @onclick="OnClose">
                    Bezárás
                </button>
                <button type="button" class="btn btn-primary" @onclick="OnViewReservations">
                    Foglalásaim
                </button>
            </div>
        </section>
    </div>
}

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public string RoomName { get; set; } = "";

    [Parameter]
    public string Schedule { get; set; } = "";

    [Parameter]
    public string Equipment { get; set; } = "";

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnViewReservations { get; set; }
}
