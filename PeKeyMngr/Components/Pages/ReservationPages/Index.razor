@page "/reservations"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Identity
@using PeKeyMngr.Models
@using PeKeyMngr.Data
@implements IAsyncDisposable
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

@attribute [Authorize(Policy = "CanAccessTeacherPages")]

<PageTitle>Foglalások kezelése</PageTitle>

<div class="container py-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h3 class="mb-1">Foglalások kezelése</h3>
            <p class="text-muted mb-0">
                A termekhez kapcsolódó foglalások és igényelt eszközök áttekintése.
            </p>
        </div>

        <a href="/booking" class="btn btn-primary">
            Új foglalás
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-light py-3">
            <h5 class="mb-0">Nyilvántartott foglalások</h5>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <QuickGrid Class="table table-hover align-middle mb-0" Items="reservations">
                    <PropertyColumn Property="reservation => reservation.StartTime" Title="Kezdés" />
                    <PropertyColumn Property="reservation => reservation.EndTime" Title="Befejezés" />
                    <PropertyColumn Property="reservation => reservation.Room.RoomName" Title="Terem" />
                    <PropertyColumn Property="reservation => GetEquipments(reservation.ReservationId)" Title="Igényelt eszközök" />

                    <TemplateColumn Context="reservation" Title="Műveletek">
                        <div class="d-flex flex-wrap gap-2">
                            <a href="@($"reservations/edit?reservationid={reservation.ReservationId}")"
                               class="btn btn-sm btn-outline-primary">
                                Szerkesztés
                            </a>
                            <a href="@($"reservations/details?reservationid={reservation.ReservationId}")"
                               class="btn btn-sm btn-outline-secondary">
                                Részletek
                            </a>
                            <a href="@($"reservations/delete?reservationid={reservation.ReservationId}")"
                               class="btn btn-sm btn-outline-danger">
                                Törlés
                            </a>
                        </div>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>
    </div>
</div>

@code {
    private ApplicationDbContext context = default!;
    private IQueryable<Reservation> reservations = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
        reservations = context.Reservations.Where(_ => false);
    }

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        string? userId = UserManager.GetUserId(authenticationState.User);
        if (userId is null)
        {
            throw new InvalidOperationException("A bejelentkezett tanár azonosítója nem érhető el.");
        }

        reservations = context.Reservations
            .Where(reservation => reservation.RequestedBy.Id == userId)
            .Include(reservation => reservation.Room)
            .Include(reservation => reservation.Equipments);
    }

    public string GetEquipments(Guid reservationId)
    {
        using var context = DbFactory.CreateDbContext();
        Reservation? res = context.Reservations.Include(r => r.Equipments).FirstOrDefault(r => r.ReservationId == reservationId);
        if (res is null)
        {
            return "Nincs igényelt eszköz";
        }

        return string.Join(", ", res.Equipments.Select(e => e.EquipmentName)).TrimEnd();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}