@page "/reservations/details"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Models
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@attribute [Authorize(Policy = "CanAccessTeacherPages")]

<PageTitle>Részletek</PageTitle>

<h1>Részletek</h1>

<div>
    <h2>Foglalás</h2>
    <hr />
    @if (reservation is null)
    {
        <p><em>Betöltés...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Kezdés időpontja</dt>
            <dd class="col-sm-10">@reservation.StartTime</dd>
            <dt class="col-sm-2">Befejezés időpontja</dt>
            <dd class="col-sm-10">@reservation.EndTime</dd>
        </dl>
        <div>
            <a href="@($"/reservations/edit?reservationid={reservation.ReservationId}")">Szerkesztés</a> |
            <a href="@($"/reservations")">Vissza a listához</a>
        </div>
    }
</div>

@code {
    private Reservation? reservation;

    [SupplyParameterFromQuery]
    private Guid ReservationId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        reservation = await context.Reservations.FirstOrDefaultAsync(m => m.ReservationId == ReservationId);

        if (reservation is null)
        {
            NavigationManager.NotFound();
        }
    }
}
