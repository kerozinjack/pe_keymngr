@page "/reservations/details"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Data
@using PeKeyMngr.Models
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

@attribute [Authorize(Policy = "CanAccessTeacherPages")]

<PageTitle>Foglalás részletei</PageTitle>

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h2 fw-bold mb-1">Foglalás részletei</h1>
        <p class="text-muted mb-0">A foglalás időpontja, helyszíne és igényelt felszerelései.</p>
    </div>

    @if (reservation is null)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted mb-0"><em>Betöltés...</em></p>
            </div>
        </div>
    }
    else
    {
        <section class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h2 class="h5 mb-0">Foglalás adatai</h2>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 col-lg-3">Kezdés</dt>
                    <dd class="col-sm-8 col-lg-9">
                        @reservation.StartTime.ToString("yyyy/MM/dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)
                    </dd>

                    <dt class="col-sm-4 col-lg-3">Befejezés</dt>
                    <dd class="col-sm-8 col-lg-9">
                        @reservation.EndTime.ToString("yyyy/MM/dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)
                    </dd>

                    <dt class="col-sm-4 col-lg-3">Időtartam</dt>
                    <dd class="col-sm-8 col-lg-9">@DurationText</dd>

                    <dt class="col-sm-4 col-lg-3">Terem</dt>
                    <dd class="col-sm-8 col-lg-9">
                        @reservation.Room.Building épület · @reservation.Room.Floor · @reservation.Room.RoomName
                    </dd>

                    <dt class="col-sm-4 col-lg-3">Kért extra felszerelések</dt>
                    <dd class="col-sm-8 col-lg-9">
                        @(reservation.Equipments.Count == 0
                            ? "Nincs kért extra felszerelés"
                            : string.Join(", ", reservation.Equipments.Select(equipment => equipment.EquipmentName)))
                    </dd>
                </dl>
            </div>
            <div class="card-footer bg-white d-flex flex-wrap justify-content-between gap-2 py-3">
                <a class="btn btn-outline-secondary" href="/reservations">Vissza a listához</a>
                <a class="btn btn-primary"
                   href="@($"/reservations/edit?reservationid={reservation.ReservationId}")">
                    Szerkesztés
                </a>
            </div>
        </section>
    }
</div>

@code {
    private Reservation? reservation;
    private string DurationText
    {
        get
        {
            if (reservation is null)
            {
                return "";
            }

            int totalMinutes = (int)(reservation.EndTime - reservation.StartTime).TotalMinutes;
            int hours = totalMinutes / 60;
            int minutes = totalMinutes % 60;
            return (hours, minutes) switch
            {
                (0, _) => $"{minutes} perc",
                (_, 0) => $"{hours} óra",
                _ => $"{hours} óra {minutes} perc"
            };
        }
    }

    [SupplyParameterFromQuery]
    private Guid ReservationId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        string? userId = UserManager.GetUserId(authenticationState.User);
        if (userId is null)
        {
            NavigationManager.NotFound();
            return;
        }

        await using var context = await DbFactory.CreateDbContextAsync();
        reservation = await context.Reservations
            .Include(item => item.Room)
            .Include(item => item.Equipments)
            .FirstOrDefaultAsync(item => item.ReservationId == ReservationId && item.RequestedBy.Id == userId);

        if (reservation is null)
        {
            NavigationManager.NotFound();
        }
    }
}
