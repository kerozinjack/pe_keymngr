@page "/users"
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using PeKeyMngr.Data
@attribute [Authorize(Policy = "CanAccessAdminPages")]
@inject AdminUserRoleService RoleService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<PeKeyMngr.Components.Pages.UserPages.Index> Logger

<PageTitle>Felhasználók és jogosultságok – PeKeyMngr</PageTitle>

<div class="container-fluid py-4 px-3 px-lg-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="badge bg-primary-subtle text-primary mb-2">ADMINISZTRÁCIÓ</span>
            <h2 class="fw-bold mb-1">Felhasználók és jogosultságok</h2>
            <p class="text-muted mb-0">Regisztrált fiókok áttekintése és szerepkörök hozzárendelése.</p>
        </div>
        <button type="button" class="btn btn-outline-secondary" disabled="@(IsLoading || IsSaving)"
                @onclick="RefreshAsync">@(IsLoading ? "Betöltés..." : "Adatok frissítése")</button>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@ErrorMessage</div>
    }
    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="alert alert-success" role="status">@SuccessMessage</div>
    }

    <div class="row row-cols-1 row-cols-sm-3 g-3 mb-4">
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body border-start border-4 border-primary rounded p-3">
                    <div class="text-muted small">Regisztrált felhasználók</div>
                    <div class="fs-3 fw-bold">@Users.Count</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body border-start border-4 border-warning rounded p-3">
                    <div class="text-muted small">Szerepkör nélkül</div>
                    <div class="fs-3 fw-bold">@Users.Count(user => user.RoleIds.Count == 0)</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body border-start border-4 border-success rounded p-3">
                    <div class="text-muted small">E-mail megerősítve</div>
                    <div class="fs-3 fw-bold">@Users.Count(user => user.EmailConfirmed)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 align-items-start">
        <div class="col-12 col-xl-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-body py-3 px-4">
                    <h5 class="fw-bold mb-1">Felhasználók</h5>
                    <p class="text-muted small mb-3">A szerepkör nélküli új fiókok is megjelennek.</p>
                    <input class="form-control" type="search" aria-label="Felhasználó keresése"
                           placeholder="Keresés e-mail-cím alapján..."
                           @bind="SearchText" @bind:event="oninput" />
                </div>
                <div class="card-body p-0">
                    @if (IsLoading)
                    {
                        <div class="p-4 text-muted">Felhasználók betöltése...</div>
                    }
                    else if (FilteredUsers.Count == 0)
                    {
                        <div class="p-4 text-muted">Nincs a keresésnek megfelelő felhasználó.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Felhasználó</th>
                                        <th>Jogosultságok</th>
                                        <th class="text-end pe-4">Művelet</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (AdminUserRow user in FilteredUsers)
                                    {
                                        <tr @key="user.UserId" class="@(SelectedUserId == user.UserId ? "table-primary" : null)">
                                            <td class="ps-4">
                                                <div class="fw-semibold">@user.Email</div>
                                                @if (!user.EmailConfirmed)
                                                {
                                                    <span class="badge bg-warning-subtle text-warning-emphasis">E-mail nincs megerősítve</span>
                                                }
                                            </td>
                                            <td>
                                                @if (user.RoleNames.Count == 0)
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary-emphasis">Nincs szerepkör</span>
                                                }
                                                else
                                                {
                                                    <div class="d-flex flex-wrap gap-1">
                                                        @foreach (string name in user.RoleNames)
                                                        {
                                                            <span class="badge bg-primary-subtle text-primary-emphasis" @key="name">@name</span>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                            <td class="text-end pe-4">
                                                <button type="button" class="btn btn-sm btn-outline-primary"
                                                        disabled="@IsSaving" @onclick="() => SelectUser(user.UserId)">
                                                    Jogosultságok
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-5">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-body py-3 px-4">
                    <h5 class="fw-bold mb-1">Szerepkörök módosítása</h5>
                    <p class="small text-muted mb-0">Jelöld ki a hozzáadni vagy elvenni kívánt jogosultságokat.</p>
                </div>
                <div class="card-body p-4">
                    @if (SelectedUser is null)
                    {
                        <p class="text-muted mb-0">Válassz ki egy felhasználót a bal oldali listából.</p>
                    }
                    else
                    {
                        <div class="mb-3">
                            <div class="fw-semibold">@SelectedUser.Email</div>
                            <div class="small text-muted">
                                @(SelectedUser.EmailConfirmed ? "Megerősített e-mail" : "Megerősítésre váró e-mail")
                            </div>
                        </div>

                        @if (AvailableRoles.Count == 0)
                        {
                            <div class="alert alert-warning mb-3">Nincsenek szerepkörök az adatbázisban. Először hozz létre egyet a Szerepkörök oldalon.</div>
                        }
                        else
                        {
                            <div class="d-grid gap-2 mb-4">
                                @foreach (AdminRoleOption role in AvailableRoles)
                                {
                                    <div class="form-check border rounded-3 px-3 py-2 d-flex align-items-center gap-2" @key="role.RoleId">
                                        <input class="form-check-input ms-0 mt-0" type="checkbox"
                                               id="@($"user-role-{role.RoleId:N}")"
                                               checked="@SelectedRoleIds.Contains(role.RoleId)"
                                               disabled="@IsSaving"
                                               @onchange="(ChangeEventArgs args) => ChangeRoleSelection(role.RoleId, args)" />
                                        <label class="form-check-label flex-grow-1" for="@($"user-role-{role.RoleId:N}")">@role.RoleName</label>
                                    </div>
                                }
                            </div>
                        }

                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-primary" disabled="@(IsSaving || !HasChanges || AvailableRoles.Count == 0)"
                                    @onclick="SaveAsync">
                                @(IsSaving ? "Mentés..." : "Változtatások mentése")
                            </button>
                            <button type="button" class="btn btn-outline-secondary" disabled="@IsSaving"
                                    @onclick="CancelSelection">Mégse</button>
                        </div>
                    }
                </div>
                <div class="card-footer bg-body text-muted small px-4 py-3">
                    A regisztráció nem ad automatikusan tanári jogosultságot. A jogosultság kiosztása és az e-mail megerősítése külön művelet.
                    A módosítások után az érintett felhasználónál oldalfrissítés vagy új bejelentkezés lehet szükséges.
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<AdminUserRow> Users { get; set; } = [];
    private List<AdminRoleOption> AvailableRoles { get; set; } = [];
    private string SearchText { get; set; } = string.Empty;
    private string? SelectedUserId { get; set; }
    private HashSet<Guid> SelectedRoleIds { get; set; } = [];
    private HashSet<Guid> PreviousRoleIds { get; set; } = [];
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private bool IsLoading { get; set; }
    private bool IsSaving { get; set; }

    private AdminUserRow? SelectedUser => Users.FirstOrDefault(user => user.UserId == SelectedUserId);

    private List<AdminUserRow> FilteredUsers => Users
        .Where(user => user.Email.Contains(SearchText.Trim(), StringComparison.OrdinalIgnoreCase))
        .ToList();

    private bool HasChanges => !SelectedRoleIds.SetEquals(PreviousRoleIds);

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private async Task<string?> GetCurrentUserIdAsync()
    {
        AuthenticationState state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return state.User.FindFirstValue(ClaimTypes.NameIdentifier);
    }

    private async Task RefreshAsync()
    {
        if (IsSaving || IsLoading)
        {
            return;
        }

        IsLoading = true;
        ErrorMessage = null;

        try
        {
            string? actorId = await GetCurrentUserIdAsync();
            AdminUsersOverview overview = await RoleService.GetOverviewAsync(actorId);
            Users = overview.Users.ToList();
            AvailableRoles = overview.Roles.ToList();
            SyncSelectedUser();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Nem sikerült lekérni a felhasználók jogosultságait.");
            ErrorMessage = "Nem sikerült betölteni a felhasználókat. Próbáld újra.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void SyncSelectedUser()
    {
        AdminUserRow? selected = SelectedUser;
        if (selected is null)
        {
            CancelSelection();
            return;
        }

        PreviousRoleIds = selected.RoleIds.ToHashSet();
        SelectedRoleIds = selected.RoleIds.ToHashSet();
    }

    private void SelectUser(string userId)
    {
        SelectedUserId = userId;
        ErrorMessage = null;
        SuccessMessage = null;
        SyncSelectedUser();
    }

    private void CancelSelection()
    {
        SelectedUserId = null;
        SelectedRoleIds = [];
        PreviousRoleIds = [];
    }

    private void ChangeRoleSelection(Guid roleId, ChangeEventArgs args)
    {
        if (args.Value is bool selected && selected)
        {
            SelectedRoleIds.Add(roleId);
        }
        else
        {
            SelectedRoleIds.Remove(roleId);
        }
    }

    private async Task SaveAsync()
    {
        if (IsSaving || SelectedUserId is null || !HasChanges)
        {
            return;
        }

        IsSaving = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            string? actorId = await GetCurrentUserIdAsync();
            AdminRoleUpdateResult result = await RoleService.UpdateRolesAsync(
                actorId, SelectedUserId, PreviousRoleIds, SelectedRoleIds);

            if (!result.Success)
            {
                ErrorMessage = result.Message;
                return;
            }

            SuccessMessage = result.Message;
            AdminUsersOverview overview = await RoleService.GetOverviewAsync(actorId);
            Users = overview.Users.ToList();
            AvailableRoles = overview.Roles.ToList();
            SyncSelectedUser();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Hiba történt a felhasználói jogosultságok módosításakor.");
            ErrorMessage = "Nem sikerült menteni a jogosultságokat.";
        }
        finally
        {
            IsSaving = false;
        }
    }
}
