@page "/maintenancewindows/edit"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Models
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@attribute [Authorize(Policy = "CanAccessAdminPages")]
@rendermode InteractiveServer

<PageTitle>Karbantartási időszak szerkesztése</PageTitle>

<div class="container py-4">
    <div class="mb-4">
        <h3 class="mb-1">Karbantartási időszak szerkesztése</h3>
        <p class="text-muted mb-0">
            A karbantartási időszak adatainak és az érintett termek módosítása.
        </p>
    </div>

    @if (MaintenanceWindow is null)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <div class="spinner-border text-primary mb-3" role="status">
                    <span class="visually-hidden">Betöltés...</span>
                </div>
                <p class="text-muted mb-0">A karbantartási időszak adatainak betöltése...</p>
            </div>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-12 col-lg-9 col-xl-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-light py-3">
                        <h5 class="mb-0">Karbantartási adatok</h5>
                    </div>

                    <EditForm method="post" Model="MaintenanceWindow" OnValidSubmit="UpdateMaintenanceWindow" FormName="edit" Enhance>
                        <DataAnnotationsValidator />

                        <input type="hidden" name="MaintenanceWindow.MaintenanceWindowId" value="@MaintenanceWindow.MaintenanceWindowId" />

                        <div class="card-body p-4">
                            <ValidationSummary class="text-danger mb-3" role="alert" />

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="starttime" class="form-label">Kezdés dátuma</label>
                                    <InputDate id="starttime"
                                               @bind-Value="MaintenanceWindow.StartTime"
                                               class="form-control" />
                                    <ValidationMessage For="() => MaintenanceWindow.StartTime" class="text-danger" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="endtime" class="form-label">Befejezés dátuma</label>
                                    <InputDate id="endtime"
                                               @bind-Value="MaintenanceWindow.EndTime"
                                               class="form-control" />
                                    <ValidationMessage For="() => MaintenanceWindow.EndTime" class="text-danger" />
                                </div>
                            </div>

                            <hr class="my-4" />

                            <div class="mb-3">
                                <h6 class="mb-1">Érintett termek</h6>
                                <p class="text-muted small mb-3">
                                    Válaszd ki azokat a termeket, amelyekre a karbantartás vonatkozik.
                                </p>

                                <div class="row g-2">
                                    @foreach (KeyValuePair<Guid, string> kvp in GetRooms())
                                    {
                                        <div class="col-12 col-sm-6 col-md-4">
                                            <div class="form-check border rounded p-3 h-100">
                                                <input type="checkbox"
                                                       class="form-check-input"
                                                       id="@kvp.Key"
                                                       @onchange="args => ToggleRoom(kvp.Key, args)"
                                                       checked="@IsAffectedRoom(kvp.Key)" />
                                                <label class="form-check-label ms-2" for="@kvp.Key">
                                                    @kvp.Value
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                            <a href="/maintenancewindows" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>
                                Vissza a listához
                            </a>

                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-2"></i>
                                Módosítások mentése
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    private Guid MaintenanceWindowId { get; set; }

    [SupplyParameterFromForm]
    private MaintenanceWindow? MaintenanceWindow { get; set; }

    private List<Room> AffRooms = [];

    private Dictionary<Guid, string> GetRooms()
    {
        using var context = DbFactory.CreateDbContext();

        if (MaintenanceWindow is null)
        {
            return new();
        }
        return context.Rooms.ToDictionary(k => k.RoomId, v => v.RoomName);
    }

    public bool IsAffectedRoom(Guid roomId)
    {
        if (MaintenanceWindow is null)
        {
            return false;
        }
        using var context = DbFactory.CreateDbContext();
        return context.MaintenanceWindows.Include(mw => mw.AffectedRooms).Where(mw => mw.MaintenanceWindowId == MaintenanceWindowId).SelectMany(mw => mw.AffectedRooms).Any(r => r.RoomId == roomId);
    }

    private void ToggleRoom(Guid roomId, ChangeEventArgs args)
    {
        using var context = DbFactory.CreateDbContext();
        Room? r = context.Rooms.FirstOrDefault(room => room.RoomId == roomId);
        if (r == null)
        {
            return;
        }
        if (args.Value is bool and true)
        {
            if (!AffRooms.Contains(r))
            {
                AffRooms.Add(r);
            }
        }
        else
        {
            AffRooms = AffRooms.FindAll(x => x.RoomId != r.RoomId);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        MaintenanceWindow ??= await context.MaintenanceWindows.Include(mw => mw.AffectedRooms).FirstOrDefaultAsync(m => m.MaintenanceWindowId == MaintenanceWindowId);

        if (MaintenanceWindow is null)
        {
            NavigationManager.NotFound();
        }
        AffRooms = MaintenanceWindow!.AffectedRooms;
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateMaintenanceWindow()
    {
        using var context = DbFactory.CreateDbContext();
        MaintenanceWindow? mw = context.MaintenanceWindows.Include(mw => mw.AffectedRooms).FirstOrDefault(m => m.MaintenanceWindowId == MaintenanceWindowId);

        if (mw is null)
        {
            NavigationManager.NotFound();
            return;
        }

        context.Attach(mw).State = EntityState.Modified;
        mw.AffectedRooms.Clear();
        foreach (Room room in AffRooms)
        {
            context.Attach(room).State = EntityState.Unchanged;
            mw.AffectedRooms.Add(room);
        }


        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!MaintenanceWindowExists(MaintenanceWindow!.MaintenanceWindowId))
            {
                NavigationManager.NotFound();
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/maintenancewindows");
    }

    private bool MaintenanceWindowExists(Guid maintenancewindowid)
    {
        using var context = DbFactory.CreateDbContext();
        return context.MaintenanceWindows.Any(e => e.MaintenanceWindowId == maintenancewindowid);
    }
}