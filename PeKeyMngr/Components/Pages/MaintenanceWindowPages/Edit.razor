@page "/maintenancewindows/edit"
@using Microsoft.AspNetCore.Authorization
@using System.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.EntityFrameworkCore.Storage
@using PeKeyMngr.Models
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@attribute [Authorize(Policy = "CanAccessAdminPages")]
@rendermode InteractiveServer

<PageTitle>Karbantartási időszak szerkesztése</PageTitle>

<div class="container py-4">
    <div class="mb-4">
        <h3 class="mb-1">Karbantartási időszak szerkesztése</h3>
        <p class="text-muted mb-0">
            A karbantartási időszak adatainak és az érintett termek módosítása.
        </p>
    </div>

    @if (MaintenanceWindow is null)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <div class="spinner-border text-primary mb-3" role="status">
                    <span class="visually-hidden">Betöltés...</span>
                </div>
                <p class="text-muted mb-0">A karbantartási időszak adatainak betöltése...</p>
            </div>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-12 col-lg-9 col-xl-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-light py-3">
                        <h5 class="mb-0">Karbantartási adatok</h5>
                    </div>

                    <EditForm method="post" EditContext="editContext" OnSubmit="SubmitWithoutConfirmation" FormName="edit" Enhance>
                        <DataAnnotationsValidator />

                        <input type="hidden" name="MaintenanceWindow.MaintenanceWindowId" value="@MaintenanceWindow.MaintenanceWindowId" />

                        <div class="card-body p-4">
                            <ValidationSummary class="text-danger mb-3" role="alert" />

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="starttime" class="form-label">Kezdés dátuma</label>
                                    <InputDate Type="InputDateType.DateTimeLocal"
                                               id="starttime"
                                               @bind-Value="MaintenanceWindow.StartTime"
                                               @bind-Value:after="ResetConflicts"
                                               disabled="@isSaving"
                                               class="form-control" />
                                    <ValidationMessage For="() => MaintenanceWindow.StartTime" class="text-danger" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="endtime" class="form-label">Befejezés dátuma</label>
                                    <InputDate Type="InputDateType.DateTimeLocal"
                                               id="endtime"
                                               @bind-Value="MaintenanceWindow.EndTime"
                                               @bind-Value:after="ResetConflicts"
                                               disabled="@isSaving"
                                               class="form-control" />
                                    <ValidationMessage For="() => MaintenanceWindow.EndTime" class="text-danger" />
                                </div>
                            </div>

                            <hr class="my-4" />

                            <div class="mb-3">
                                <h6 class="mb-1">Érintett termek</h6>
                                <p class="text-muted small mb-3">
                                    Válassza ki azokat a termeket, amelyekre a karbantartás vonatkozik.
                                </p>

                                <div class="row g-2">
                                    @foreach (KeyValuePair<Guid, string> kvp in rooms)
                                    {
                                        <div class="col-12 col-sm-6 col-md-4">
                                            <div class="form-check border rounded p-3 h-100">
                                                <input type="checkbox"
                                                       class="form-check-input"
                                                       id="@kvp.Key"
                                                       disabled="@isSaving"
                                                       @onchange="args => ToggleRoom(kvp.Key, args)"
                                                       checked="@IsAffectedRoom(kvp.Key)" />
                                                <label class="form-check-label ms-2" for="@kvp.Key">
                                                    @kvp.Value
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <ValidationMessage For="() => MaintenanceWindow.AffectedRooms" class="text-danger" />
                                <ReservationConflictWarning Conflicts="conflicts" IsSaving="isSaving"
                                                            OnConfirm="SubmitWithConfirmation" OnAdjust="ResetConflicts" />
                            </div>
                        </div>

                        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                            <a href="/maintenancewindows" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>
                                Vissza a listához
                            </a>

                            <button type="submit" class="btn btn-primary" disabled="@(isSaving || conflicts.Count > 0)">
                                <i class="bi bi-check-lg me-2"></i>
                                Módosítások mentése
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    private Guid MaintenanceWindowId { get; set; }

    [SupplyParameterFromForm]
    private MaintenanceWindow? MaintenanceWindow { get; set; }

    private EditContext editContext = default!;
    private ValidationMessageStore validationMessages = default!;
    private Dictionary<Guid, string> rooms = [];
    private List<ReservationConflict> conflicts = [];
    private bool isSaving;
    private int conflictVersion;

    public bool IsAffectedRoom(Guid roomId)
    {
        if (MaintenanceWindow is null)
        {
            return false;
        }
        return MaintenanceWindow.AffectedRooms.Any(room => room.RoomId == roomId);
    }

    private void ToggleRoom(Guid roomId, ChangeEventArgs args)
    {
        ResetConflicts();
        using var context = DbFactory.CreateDbContext();
        Room? r = context.Rooms.FirstOrDefault(room => room.RoomId == roomId);
        if (r == null)
        {
            return;
        }
        if (args.Value is bool and true)
        {
            if (!MaintenanceWindow!.AffectedRooms.Any(room => room.RoomId == r.RoomId))
            {
                MaintenanceWindow.AffectedRooms.Add(r);
            }
        }
        else
        {
            MaintenanceWindow!.AffectedRooms.RemoveAll(room => room.RoomId == r.RoomId);
        }

        editContext.NotifyFieldChanged(new FieldIdentifier(
            MaintenanceWindow!, nameof(MaintenanceWindow.AffectedRooms)));
    }

    private void ResetConflicts()
    {
        conflicts = [];
        conflictVersion++;
    }

    private Task SubmitWithoutConfirmation() => SubmitMaintenanceWindow(false);
    private Task SubmitWithConfirmation() => SubmitMaintenanceWindow(true);

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        MaintenanceWindow ??= await context.MaintenanceWindows.Include(mw => mw.AffectedRooms).FirstOrDefaultAsync(m => m.MaintenanceWindowId == MaintenanceWindowId);

        if (MaintenanceWindow is null)
        {
            NavigationManager.NotFound();
            return;
        }

        editContext = new EditContext(MaintenanceWindow);
        validationMessages = new ValidationMessageStore(editContext);
        rooms = await context.Rooms.ToDictionaryAsync(k => k.RoomId, v => v.RoomName);
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task SubmitMaintenanceWindow(bool confirmed)
    {
        if (isSaving)
        {
            return;
        }

        validationMessages.Clear();
        bool isValid = editContext.Validate();

        if (MaintenanceWindow!.EndTime <= MaintenanceWindow.StartTime)
        {
            validationMessages.Add(
                new FieldIdentifier(MaintenanceWindow, nameof(MaintenanceWindow.EndTime)),
                "A befejezés időpontjának a kezdés időpontja után kell lennie.");
        }

        if (MaintenanceWindow.AffectedRooms.Count == 0)
        {
            validationMessages.Add(
                new FieldIdentifier(MaintenanceWindow, nameof(MaintenanceWindow.AffectedRooms)),
                "Legalább egy érintett termet ki kell választani.");
        }

        editContext.NotifyValidationStateChanged();
        if (!isValid || editContext.GetValidationMessages().Any())
        {
            return;
        }

        int submittedVersion = conflictVersion;
        DateTime start = MaintenanceWindow.StartTime;
        DateTime end = MaintenanceWindow.EndTime;
        List<Guid> roomIds = MaintenanceWindow.AffectedRooms.Select(room => room.RoomId).ToList();
        isSaving = true;
        try
        {
            using var context = DbFactory.CreateDbContext();
            await using IDbContextTransaction transaction =
                await context.Database.BeginTransactionAsync(IsolationLevel.Serializable);
            List<ReservationConflict> currentConflicts = await ReservationConflictQuery.FindAsync(
                context, roomIds, start, end);

            if (submittedVersion != conflictVersion)
            {
                return;
            }

            if (currentConflicts.Count > 0 && (!confirmed || !conflicts.SequenceEqual(currentConflicts)))
            {
                conflicts = currentConflicts;
                return;
            }

            MaintenanceWindow? mw = await context.MaintenanceWindows
                .Include(window => window.AffectedRooms)
                .FirstOrDefaultAsync(window => window.MaintenanceWindowId == MaintenanceWindowId);

            if (mw is null)
            {
                NavigationManager.NotFound();
                return;
            }

            List<Room> rooms = await context.Rooms.Where(room => roomIds.Contains(room.RoomId)).ToListAsync();
            if (submittedVersion != conflictVersion)
            {
                return;
            }
            if (rooms.Count != roomIds.Count)
            {
                validationMessages.Add(
                    new FieldIdentifier(MaintenanceWindow, nameof(MaintenanceWindow.AffectedRooms)),
                    "A kiválasztott termek megváltoztak. Frissítse az oldalt.");
                editContext.NotifyValidationStateChanged();
                return;
            }

            if (confirmed && !await ReservationConflictQuery.DeleteAsync(context, currentConflicts))
            {
                validationMessages.Add(
                    new FieldIdentifier(MaintenanceWindow, nameof(MaintenanceWindow.AffectedRooms)),
                    "Az ütköző foglalások nem törölhetők, mert más adatok kapcsolódnak hozzájuk. A karbantartás nem lett mentve.");
                editContext.NotifyValidationStateChanged();
                return;
            }
            if (submittedVersion != conflictVersion)
            {
                return;
            }

            mw.StartTime = start;
            mw.EndTime = end;
            mw.AffectedRooms.Clear();
            mw.AffectedRooms.AddRange(rooms);
            await context.SaveChangesAsync();
            if (submittedVersion != conflictVersion)
            {
                return;
            }
            await transaction.CommitAsync();
            NavigationManager.NavigateTo("/maintenancewindows");
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!MaintenanceWindowExists(MaintenanceWindow!.MaintenanceWindowId))
            {
                NavigationManager.NotFound();
            }
            else
            {
                throw;
            }
        }

        finally
        {
            isSaving = false;
        }
    }

    private bool MaintenanceWindowExists(Guid maintenancewindowid)
    {
        using var context = DbFactory.CreateDbContext();
        return context.MaintenanceWindows.Any(e => e.MaintenanceWindowId == maintenancewindowid);
    }
}