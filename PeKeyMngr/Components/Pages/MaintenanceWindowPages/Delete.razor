@page "/maintenancewindows/delete"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Models
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@attribute [Authorize(Policy = "CanAccessAdminPages")]

<PageTitle>Karbantartási időszak törlése</PageTitle>

<div class="container py-4">
    <div class="mb-4">
        <h3 class="mb-1">Karbantartási időszak törlése</h3>
        <p class="text-muted mb-0">
            A kiválasztott karbantartási időszak eltávolítása a rendszerből.
        </p>
    </div>

    @if (maintenancewindow is null)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <div class="spinner-border text-primary mb-3" role="status">
                    <span class="visually-hidden">Betöltés...</span>
                </div>
                <p class="text-muted mb-0">A karbantartási időszak adatainak betöltése...</p>
            </div>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8 col-xl-7">
                <div class="card shadow-sm">
                    <div class="card-header bg-light py-3">
                        <h5 class="mb-0">Törlendő karbantartási időszak adatai</h5>
                    </div>

                    <div class="card-body p-4">
                        <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-3 fs-5"></i>
                            <div>
                                <strong>Figyelem!</strong>
                                Biztosan törölni szeretné ezt a karbantartási időszakot?
                                A művelet nem vonható vissza.
                            </div>
                        </div>

                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">Kezdés időpontja</dt>
                            <dd class="col-sm-8 fw-semibold">
                                @maintenancewindow.StartTime
                            </dd>

                            <dt class="col-sm-4 text-muted">Befejezés időpontja</dt>
                            <dd class="col-sm-8 fw-semibold">
                                @maintenancewindow.EndTime
                            </dd>
                        </dl>
                    </div>

                    <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                        <a href="/maintenancewindows" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-2"></i>
                            Mégse
                        </a>

                        <EditForm method="post" Model="maintenancewindow" OnValidSubmit="DeleteMaintenanceWindow" FormName="delete" Enhance>
                            <button type="submit" class="btn btn-danger" disabled="@(maintenancewindow is null)">
                                <i class="bi bi-trash me-2"></i>
                                Karbantartás törlése
                            </button>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private MaintenanceWindow? maintenancewindow;

    [SupplyParameterFromQuery]
    private Guid MaintenanceWindowId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        maintenancewindow = await context.MaintenanceWindows.FirstOrDefaultAsync(m => m.MaintenanceWindowId == MaintenanceWindowId);

        if (maintenancewindow is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteMaintenanceWindow()
    {
        using var context = DbFactory.CreateDbContext();
        context.MaintenanceWindows.Remove(maintenancewindow!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/maintenancewindows");
    }
}