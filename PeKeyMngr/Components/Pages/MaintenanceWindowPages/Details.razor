@page "/maintenancewindows/details"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Models
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@attribute [Authorize(Policy = "CanAccessAdminPages")]

<PageTitle>Karbantartási időszak részletei</PageTitle>

<div class="container py-4">
    <div class="mb-4">
        <h3 class="mb-1">Karbantartási időszak részletei</h3>
        <p class="text-muted mb-0">
            A kiválasztott karbantartás időpontjainak és érintett termeinek megtekintése.
        </p>
    </div>

    @if (maintenancewindow is null)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <div class="spinner-border text-primary mb-3" role="status">
                    <span class="visually-hidden">Betöltés...</span>
                </div>
                <p class="text-muted mb-0">A karbantartási időszak adatainak betöltése...</p>
            </div>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8 col-xl-7">
                <div class="card shadow-sm">
                    <div class="card-header bg-light py-3">
                        <h5 class="mb-0">Karbantartási adatok</h5>
                    </div>

                    <div class="card-body p-4">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">Kezdés időpontja</dt>
                            <dd class="col-sm-8 fw-semibold">
                                @maintenancewindow.StartTime
                            </dd>

                            <dt class="col-sm-4 text-muted">Befejezés időpontja</dt>
                            <dd class="col-sm-8 fw-semibold">
                                @maintenancewindow.EndTime
                            </dd>

                            <dt class="col-sm-4 text-muted">Érintett termek</dt>
                            <dd class="col-sm-8">
                                @if (maintenancewindow.AffectedRooms.Count == 0)
                                {
                                    <span class="text-muted">Nincs megadva érintett terem.</span>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var room in maintenancewindow.AffectedRooms)
                                        {
                                            <span class="badge bg-secondary">@room.RoomName</span>
                                        }
                                    </div>
                                }
                            </dd>
                        </dl>
                    </div>

                    <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                        <a href="/maintenancewindows" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-2"></i>
                            Vissza a listához
                        </a>

                        <a href="@($"/maintenancewindows/edit?maintenancewindowid={maintenancewindow.MaintenanceWindowId}")"
                           class="btn btn-primary">
                            <i class="bi bi-pencil me-2"></i>
                            Szerkesztés
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private MaintenanceWindow? maintenancewindow;

    [SupplyParameterFromQuery]
    private Guid MaintenanceWindowId { get; set; }

    public string GetAffectedRooms()
    {
        if (maintenancewindow is null)
        {
            return string.Empty;
        }
        return string.Join(", ", maintenancewindow.AffectedRooms.Select(r => r.RoomName)).TrimEnd();
    }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        maintenancewindow = await context.MaintenanceWindows.Include(mw => mw.AffectedRooms).FirstOrDefaultAsync(m => m.MaintenanceWindowId == MaintenanceWindowId);

        if (maintenancewindow is null)
        {
            NavigationManager.NotFound();
        }
    }
}