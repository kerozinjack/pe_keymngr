@page "/maintenancewindows"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using PeKeyMngr.Models
@using PeKeyMngr.Data
@implements IAsyncDisposable
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory

@attribute [Authorize(Policy = "CanAccessAdminPages")]

<PageTitle>Karbantartási időszakok kezelése</PageTitle>

<div class="container py-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h3 class="mb-1">Karbantartási időszakok kezelése</h3>
            <p class="text-muted mb-0">
                A karbantartás alatt álló termek és időszakok áttekintése.
            </p>
        </div>

        <a href="maintenancewindows/create" class="btn btn-primary">
            Új karbantartási időszak
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-light py-3">
            <h5 class="mb-0">Nyilvántartott karbantartások</h5>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <QuickGrid Class="table table-hover align-middle mb-0" Items="context.MaintenanceWindows">
                    <PropertyColumn Property="maintenancewindow => maintenancewindow.StartTime" Title="Kezdés" />
                    <PropertyColumn Property="maintenancewindow => maintenancewindow.EndTime" Title="Befejezés" />
                    <PropertyColumn Property="maintenanceWindow => GetAffectedRooms(maintenanceWindow.MaintenanceWindowId)" Title="Érintett termek" />

                    <TemplateColumn Context="maintenancewindow" Title="Műveletek">
                        <div class="d-flex flex-wrap gap-2">
                            <a href="@($"maintenancewindows/edit?maintenancewindowid={maintenancewindow.MaintenanceWindowId}")"
                               class="btn btn-sm btn-outline-primary">
                                Szerkesztés
                            </a>
                            <a href="@($"maintenancewindows/details?maintenancewindowid={maintenancewindow.MaintenanceWindowId}")"
                               class="btn btn-sm btn-outline-secondary">
                                Részletek
                            </a>
                            <a href="@($"maintenancewindows/delete?maintenancewindowid={maintenancewindow.MaintenanceWindowId}")"
                               class="btn btn-sm btn-outline-danger">
                                Törlés
                            </a>
                        </div>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>
    </div>
</div>

@code {
    private ApplicationDbContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    private string GetAffectedRooms(Guid maintenancewindowId)
    {
        using var context = DbFactory.CreateDbContext();
        MaintenanceWindow? x = context.MaintenanceWindows.Include(m => m.AffectedRooms)
            .FirstOrDefault(m => m.MaintenanceWindowId == maintenancewindowId);
        if (x == null || x.AffectedRooms.Count == 0)
        {
            return "Nem lett megadva terem";
        }

        return string.Join(", ", x.AffectedRooms.Select(z => z.RoomName).ToList()).TrimEnd();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}