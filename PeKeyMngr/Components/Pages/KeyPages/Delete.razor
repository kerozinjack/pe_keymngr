@page "/keys/delete"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Models
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@attribute [Authorize(Policy = "CanAccessAdminPages")]

<PageTitle>Kulcs törlése</PageTitle>

<div class="container py-4">
    <div class="mb-4">
        <h3 class="mb-1">Kulcs törlése</h3>
        <p class="text-muted mb-0">
            A kiválasztott kulcs eltávolítása a rendszerből.
        </p>
    </div>

    @if (key is null)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <div class="spinner-border text-primary mb-3" role="status">
                    <span class="visually-hidden">Betöltés...</span>
                </div>
                <p class="text-muted mb-0">A kulcs adatainak betöltése...</p>
            </div>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8 col-xl-7">
                <div class="card shadow-sm">
                    <div class="card-header bg-light py-3">
                        <h5 class="mb-0">Törlendő kulcs adatai</h5>
                    </div>

                    <div class="card-body p-4">
                        <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                            <div>
                                <strong>Figyelem!</strong>
                                Biztosan törölni szeretnéd ezt a kulcsot?
                                A művelet nem vonható vissza.
                            </div>
                        </div>

                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">Kulcs neve</dt>
                            <dd class="col-sm-8 fw-semibold">
                                @key.KeyName
                            </dd>
                        </dl>
                    </div>

                    <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                        <a href="/keys" class="btn btn-outline-secondary">
                            Mégse
                        </a>

                        <EditForm method="post" Model="key" OnValidSubmit="DeleteKey" FormName="delete" Enhance>
                            <button type="submit" class="btn btn-danger" disabled="@(key is null)">
                                Kulcs törlése
                            </button>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private Key? key;

    [SupplyParameterFromQuery]
    private Guid KeyId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        key = await context.Keys.FirstOrDefaultAsync(m => m.KeyId == KeyId);

        if (key is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteKey()
    {
        using var context = DbFactory.CreateDbContext();
        context.Keys.Remove(key!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/keys");
    }
}