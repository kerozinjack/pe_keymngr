@page "/keys/edit"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Data.DTO
@using PeKeyMngr.Models
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@attribute [Authorize(Policy = "CanAccessAdminPages")]
@rendermode InteractiveServer

<PageTitle>Kulcs szerkesztése</PageTitle>

<div class="container py-4">
    <div class="mb-4">
        <h3 class="mb-1">Kulcs szerkesztése</h3>
        <p class="text-muted mb-0">
            A kulcs adatainak, terem-hozzárendeléseinek és jogosultságainak módosítása.
        </p>
    </div>

    @if (Key is null)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <div class="spinner-border text-primary mb-3" role="status">
                    <span class="visually-hidden">Betöltés...</span>
                </div>
                <p class="text-muted mb-0">A kulcs adatainak betöltése...</p>
            </div>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8 col-xl-7">
                <div class="card shadow-sm">
                    <div class="card-header bg-light py-3">
                        <h5 class="mb-0">Kulcs adatai</h5>
                    </div>

                    <EditForm method="post" Model="Key" OnValidSubmit="UpdateKey" FormName="edit" Enhance>
                        <DataAnnotationsValidator />

                        <div class="card-body p-4">
                            <ValidationSummary class="text-danger mb-3" role="alert" />

                            <div class="mb-4">
                                <label for="roomname" class="form-label fw-semibold">
                                    Kulcs neve
                                </label>
                                <InputText id="roomname"
                                           @bind-Value="Key.KeyName"
                                           class="form-control" />
                                <ValidationMessage For="() => Key.KeyName" class="text-danger" />
                            </div>

                            <hr class="my-4" />

                            <div class="mb-4">
                                <h6 class="fw-semibold mb-1">Hozzárendelt termek</h6>
                                <p class="text-muted small mb-3">
                                    Válaszd ki, mely termekhez tartozzon ez a kulcs.
                                </p>

                                <div class="border rounded p-3">
                                    @foreach (KeyValuePair<string, string> kvp in Rooms)
                                    {
                                        @if (kvp.Key is not null && kvp.Value is not null && Key.AssignedRoomIds is not null)
                                        {
                                            <div class="form-check mb-2">
                                                <input type="checkbox"
                                                       class="form-check-input"
                                                       id="@kvp.Key"
                                                       checked="@Key.AssignedRoomIds.Any(x => x.ToString("D").ToLowerInvariant() == kvp.Key)"
                                                       @onchange="e => ToggleRoom(kvp.Key, e)" />
                                                <label for="@kvp.Key" class="form-check-label">
                                                    @kvp.Value
                                                </label>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>

                            <hr class="my-4" />

                            <div class="mb-2">
                                <h6 class="fw-semibold mb-1">Szükséges szerepkörök</h6>
                                <p class="text-muted small mb-3">
                                    Válaszd ki, mely szerepkörökkel rendelkező felhasználók jogosultak a kulcs használatára.
                                </p>

                                <div class="border rounded p-3">
                                    @foreach (KeyValuePair<string, string> kvp in RequiredRoles)
                                    {
                                        @if (kvp.Key is not null && kvp.Value is not null && Key.RequiredRoleIds is not null)
                                        {
                                            <div class="form-check mb-2">
                                                <input type="checkbox"
                                                       class="form-check-input"
                                                       id="@kvp.Key"
                                                       checked="@Key.RequiredRoleIds.Any(x => x.ToString("D").ToLowerInvariant() == kvp.Key)"
                                                       @onchange="e => ToggleRole(kvp.Key, e)" />
                                                <label for="@kvp.Key" class="form-check-label">
                                                    @kvp.Value
                                                </label>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                            <a href="/keys" class="btn btn-outline-secondary">
                                Vissza
                            </a>

                            <button type="submit" class="btn btn-primary">
                                Módosítások mentése
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    private Guid KeyId { get; set; }
    private KeyDto? Key { get; set; }

    [SupplyParameterFromForm]
    private KeyDto? KeyDto { get; set; }
    private Dictionary<string, string> Rooms { get; set; } = [];
    private Dictionary<string, string> RequiredRoles { get; set; } = [];

    private void ToggleRoom(string roomId, ChangeEventArgs e)
    {
        if (KeyDto == null)
        {
            return;
        }
        if (e.Value is bool and true)
        {
            if (!KeyDto.AssignedRoomIds.Contains(Guid.Parse(roomId)))
            {
                KeyDto.AssignedRoomIds.Add(Guid.Parse(roomId));
            }
        }
        else
        {
            KeyDto.AssignedRoomIds.Remove(Guid.Parse(roomId));
        }
    }

    private void ToggleRole(string roleId, ChangeEventArgs e)
    {
        if (KeyDto == null)
        {
            return;
        }
        if (e.Value is bool and true)
        {
            if (!KeyDto.RequiredRoleIds.Contains(Guid.Parse(roleId)))
            {
                KeyDto.RequiredRoleIds.Add(Guid.Parse(roleId));
            }
        }
        else
        {
            KeyDto.RequiredRoleIds.Remove(Guid.Parse(roleId));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Rooms = context.Rooms.ToDictionary(k => k.RoomId.ToString("D").ToLowerInvariant(), v => v.RoomName);
        RequiredRoles = context.CustomRoles.ToDictionary(k => k.RoleId.ToString("D").ToLowerInvariant(), v => v.RoleName);
        KeyDto ??= new();
        Key ??= new();
        KeyDto.FromKey(await context.Keys.Include(key => key.AssignedRooms).Include(key => key.RequiredRoles).FirstOrDefaultAsync(m => m.KeyId == KeyId));
        Key.FromKey(await context.Keys.Include(key => key.AssignedRooms).Include(key => key.RequiredRoles).FirstOrDefaultAsync(m => m.KeyId == KeyId));

        if (Key is null)
        {
            NavigationManager.NotFound();
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateKey()
    {
        using var context = DbFactory.CreateDbContext();

        if (Key is null || KeyDto is null)
        {
            NavigationManager.NotFound();
        }

        Key!.RequiredRoleIds = KeyDto!.RequiredRoleIds;
        Key!.AssignedRoomIds = KeyDto!.AssignedRoomIds;

        Key editedKey = Key!.ToKey(context);
        Key? existingKey = await context.Keys.Include(key => key.AssignedRooms)
            .Include(key => key.RequiredRoles).FirstOrDefaultAsync(m => m.KeyId == KeyId);
        if (existingKey is null)
        {
            NavigationManager.NotFound();
            return;
        }
        existingKey.AssignedRooms.Clear();
        existingKey.RequiredRoles.Clear();
        existingKey.AssignedRooms.AddRange(editedKey.AssignedRooms);
        existingKey.RequiredRoles.AddRange(editedKey.RequiredRoles);
        context.Attach(existingKey).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!KeyExists(Key!.KeyId))
            {
                NavigationManager.NotFound();
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/keys");
    }

    private bool KeyExists(Guid keyid)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Keys.Any(e => e.KeyId == keyid);
    }
}