@page "/keys/create"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Data.DTO
@using PeKeyMngr.Models
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@attribute [Authorize(Policy = "CanAccessAdminPages")]
@rendermode InteractiveServer

<PageTitle>Új kulcs létrehozása</PageTitle>

<div class="container py-4">
    <div class="mb-4">
        <h3 class="mb-1">Új kulcs létrehozása</h3>
        <p class="text-muted mb-0">
            Új kulcs rögzítése, a hozzá tartozó termek és a szükséges jogosultságok megadásával.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">
            <div class="card shadow-sm">
                <div class="card-header bg-light py-3">
                    <h5 class="mb-0">Kulcs adatai</h5>
                </div>

                <EditForm method="post" Model="Key" OnValidSubmit="AddKey" FormName="create" Enhance>
                    <DataAnnotationsValidator />

                    <div class="card-body p-4">
                        <ValidationSummary class="text-danger mb-3" role="alert" />

                        <div class="mb-4">
                            <label for="roomname" class="form-label fw-semibold">
                                Kulcs neve
                            </label>
                            <InputText id="roomname"
                                       @bind-Value="Key.KeyName"
                                       class="form-control" />
                            <ValidationMessage For="() => Key.KeyName" class="text-danger" />
                        </div>

                        <hr class="my-4" />

                        <div class="mb-4">
                            <h6 class="fw-semibold mb-1">Hozzárendelt termek</h6>
                            <p class="text-muted small mb-3">
                                Válaszd ki, mely termekhez tartozzon ez a kulcs.
                            </p>

                            <div class="border rounded p-3">
                                @foreach (KeyValuePair<string, string> kvp in Rooms)
                                {
                                    @if (kvp.Key is not null && kvp.Value is not null && Key.AssignedRoomIds is not null)
                                    {
                                        <div class="form-check mb-2">
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   id="@kvp.Key"
                                                   checked="@Key.AssignedRoomIds.Any(x => x.ToString("D").ToLowerInvariant() == kvp.Key)"
                                                   @onchange="e => ToggleRoom(kvp.Key, e)" />
                                            <label for="@kvp.Key" class="form-check-label">
                                                @kvp.Value
                                            </label>
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="mb-2">
                            <h6 class="fw-semibold mb-1">Szükséges szerepkörök</h6>
                            <p class="text-muted small mb-3">
                                Válaszd ki, mely szerepkörökkel rendelkező felhasználók jogosultak a kulcs használatára.
                            </p>

                            <div class="border rounded p-3">
                                @foreach (KeyValuePair<string, string> kvp in RequiredRoles)
                                {
                                    @if (kvp.Key is not null && kvp.Value is not null && Key.RequiredRoleIds is not null)
                                    {
                                        <div class="form-check mb-2">
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   id="@kvp.Key"
                                                   checked="@Key.RequiredRoleIds.Any(x => x.ToString("D").ToLowerInvariant() == kvp.Key)"
                                                   @onchange="e => ToggleRole(kvp.Key, e)" />
                                            <label for="@kvp.Key" class="form-check-label">
                                                @kvp.Value
                                            </label>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                        <a href="/keys" class="btn btn-outline-secondary">
                            Vissza
                        </a>

                        <button type="submit" class="btn btn-primary">
                            Kulcs létrehozása
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private KeyDto Key { get; set; } = default!;
    private Dictionary<string, string> Rooms { get; set; } = [];
    private Dictionary<string, string> RequiredRoles { get; set; } = [];

    private void ToggleRoom(string roomId, ChangeEventArgs e)
    {
        if (e.Value is bool and true)
        {
            if (!Key.AssignedRoomIds.Contains(Guid.Parse(roomId)))
            {
                Key.AssignedRoomIds.Add(Guid.Parse(roomId));
            }
        }
        else
        {
            Key.AssignedRoomIds.Remove(Guid.Parse(roomId));
        }
    }

    private void ToggleRole(string roleId, ChangeEventArgs e)
    {
        if (e.Value is bool and true)
        {
            if (!Key.RequiredRoleIds.Contains(Guid.Parse(roleId)))
            {
                Key.RequiredRoleIds.Add(Guid.Parse(roleId));
            }
        }
        else
        {
            Key.RequiredRoleIds.Remove(Guid.Parse(roleId));
        }
    }

    protected override void OnInitialized()
    {
        Key ??= new();
        using var context =  DbFactory.CreateDbContext();
        Rooms = context.Rooms.ToDictionary(k => k.RoomId.ToString("D").ToLowerInvariant(), v => v.RoomName);
        RequiredRoles = context.CustomRoles.ToDictionary(k => k.RoleId.ToString("D").ToLowerInvariant(), v => v.RoleName);
    }

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddKey()
    {
        using var context = DbFactory.CreateDbContext();

        Key key = new()
        {
            KeyId = Guid.NewGuid(),
            KeyName = Key.KeyName,
            AssignedRooms = [],
            RequiredRoles = []
        };

        foreach (Guid guid in Key.AssignedRoomIds)
        {
            Room? tmp = context.Rooms.FirstOrDefault(room => room.RoomId == guid);
            if (tmp == null)
            {
                return;
            }
            key.AssignedRooms.Add(tmp);
        }

        foreach (Guid guid in Key.RequiredRoleIds)
        {
            Role? tmp = context.CustomRoles.FirstOrDefault(role => role.RoleId == guid);
            if (tmp == null)
            {
                return;
            }
            key.RequiredRoles.Add(tmp);
        }

        context.Keys.Add(key);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/keys");
    }
}