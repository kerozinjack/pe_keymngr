@page "/keys"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using PeKeyMngr.Models
@using PeKeyMngr.Data
@implements IAsyncDisposable
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@attribute [Authorize(Policy = "CanAccessAdminPages")]

<PageTitle>Kulcsok kezelése</PageTitle>

<div class="container py-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h3 class="mb-1">Kulcsok kezelése</h3>
            <p class="text-muted mb-0">
                A nyilvántartott kulcsok és azok hozzárendeléseinek kezelése.
            </p>
        </div>

        <a href="keys/create" class="btn btn-primary">
            Új kulcs
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-light py-3">
            <h5 class="mb-0">Nyilvántartott kulcsok</h5>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <QuickGrid TGridItem="Key"
                           Class="table table-hover align-middle mb-0"
                           Items="@context.Keys">

                    <TemplateColumn Title="Kulcs neve" Context="key">
                        @key.KeyName
                    </TemplateColumn>

                    <TemplateColumn Title="Hozzárendelt termek" Context="key">
                        @GetAssignedRooms(key.KeyId)
                    </TemplateColumn>

                    <TemplateColumn Title="Műveletek" Context="key">
                        <div class="d-flex gap-2">
                            <a href="@($"keys/edit?keyid={key.KeyId}")"
                               class="btn btn-sm btn-outline-primary">
                                Szerkesztés
                            </a>

                            <a href="@($"keys/details?keyid={key.KeyId}")"
                               class="btn btn-sm btn-outline-secondary">
                                Részletek
                            </a>

                            <a href="@($"keys/delete?keyid={key.KeyId}")"
                               class="btn btn-sm btn-outline-danger">
                                Törlés
                            </a>
                        </div>
                    </TemplateColumn>

                </QuickGrid>
            </div>
        </div>
    </div>
</div>

@code {
    private ApplicationDbContext context = default!;

    private string GetAssignedRooms(Guid keyId)
    {
        Key? x = context.Keys.Include(k => k.AssignedRooms)
            .FirstOrDefault(k => k.KeyId == keyId);
        if (x == null || x.AssignedRooms.Count == 0)
        {
            return "Nincs hozzárendelt szoba";
        }


        return string.Join(", ", x.AssignedRooms.Select(room => room.RoomName)).TrimEnd();
    }

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}