@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@rendermode InteractiveServer
@inject NavigationManager Nav

<PageTitle>Kezdőlap – Terem- és kulcskezelő rendszer</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="container-fluid py-4">

            <!-- FEJLÉC -->
            <div class="mb-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <span class="badge bg-primary-subtle text-primary mb-2">
                            INFORMATIKAI KAR
                        </span>
                        <h2 class="fw-bold mb-1">Üdvözöljük a rendszerben!</h2>
                        <p class="text-muted mb-0">
                            Terem- és kulcskezelő rendszer – válassza ki a használni kívánt funkciót.
                        </p>
                    </div>
                    <div class="text-md-end">
                        <span class="text-muted small">Központi kezelőfelület</span>
                        <div class="fw-semibold">PeKeyMngr</div>
                    </div>
                </div>
            </div>

            <!-- IDEIGLENES SZEREPKÖRVÁLASZTÓ -->
            <div class="card shadow-sm border-warning mb-4">
                <div class="card-body p-3">
                    <div class="row align-items-center g-3">
                        <div class="col-12 col-md">
                            <h5 class="fw-semibold mb-1">
                                Tesztelési szerepkörválasztó
                            </h5>
                            <p class="text-muted small mb-0">
                                Válasszon szerepkört a hozzá tartozó kezdőlap megtekintéséhez.
                            </p>
                        </div>

                        <div class="col-12 col-md-5 col-lg-4">
                            <select class="form-select" @bind="SelectedRole">
                                <option value="Oktató / Igénylő">Oktató / Igénylő</option>
                                <option value="Portás / Operátor">Portás / Operátor</option>
                                <option value="Adminisztrátor">Adminisztrátor</option>
                                <option value="Üzemeltetési igazgató">Üzemeltetési igazgató</option>
                            </select>
                        </div>
                    </div>

                    <div class="alert alert-warning small mb-0 mt-3 py-2">
                        Ez a választó kizárólag tesztelési célokat szolgál.
                        A tényleges jogosultságkezelés még nincs bekötve.
                    </div>
                </div>
            </div>

            <!-- AKTUÁLIS SZEREPKÖR -->
            <div class="mb-3">
                <h5 class="fw-semibold mb-1">@SelectedRole</h5>
                <p class="text-muted small mb-0">
                    A kiválasztott szerepkörhöz tartozó funkciók.
                </p>
            </div>

            <div class="row g-4">

                <!-- OKTATÓ -->
                @if (SelectedRole == "Oktató / Igénylő")
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body p-4">
                                <p class="text-muted small mb-4">
                                    Termek és idősávok foglalása, valamint speciális igények megadása.
                                </p>

                                <div class="d-grid gap-2">
                                    <a href="/reservations" class="btn btn-outline-primary">
                                        Foglalások megtekintése
                                    </a>
                                    <span class="text-muted small text-center">
                                        Új foglalás – fejlesztés alatt
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- PORTÁS -->
                @if (SelectedRole == "Portás / Operátor")
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body p-4">
                                <p class="text-muted small mb-4">
                                    Kulcskiadással, kulcsátvétellel és hibabejelentésekkel kapcsolatos feladatok.
                                </p>

                                <div class="d-grid gap-2">
                                    <a href="/issuetickets" class="btn btn-outline-success">
                                        Hibajegyek kezelése
                                    </a>
                                    <span class="text-muted small text-center">
                                        Kulcskiadás és -átvétel – fejlesztés alatt
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- ADMINISZTRÁTOR -->
                @if (SelectedRole == "Adminisztrátor")
                {
                    <div class="col-12">
                        <div class="mb-4">
                            <h4 class="fw-bold mb-1">Rendszeráttekintés</h4>
                            <p class="text-muted mb-0">
                                A rendszer aktuális állapotának és legfontosabb adatainak áttekintése.
                            </p>
                        </div>

                        <!-- IDEIGLENES TESZTADATOK
                             TODO: Később valódi adatbázis-lekérdezésekre kell cserélni. -->
                        <div class="row g-3 mb-4">
                            <div class="col-6 col-xl-3">
                                <div class="card h-100 border-0 shadow-sm">
                                    <div class="card-body p-3 border-start border-4 border-primary rounded">
                                        <div class="text-muted small mb-1">Kiadott kulcsok</div>
                                        <div class="fs-3 fw-bold text-dark">
                                            12 <span class="fs-6 text-muted fw-normal">/ 48</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6 col-xl-3">
                                <div class="card h-100 border-0 shadow-sm">
                                    <div class="card-body p-3 border-start border-4 border-success rounded">
                                        <div class="text-muted small mb-1">Mai foglalások</div>
                                        <div class="fs-3 fw-bold text-dark">24</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6 col-xl-3">
                                <div class="card h-100 border-0 shadow-sm">
                                    <div class="card-body p-3 border-start border-4 border-danger rounded">
                                        <div class="text-muted small mb-1">Késésben lévő kulcsok</div>
                                        <div class="fs-3 fw-bold text-danger">2</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6 col-xl-3">
                                <div class="card h-100 border-0 shadow-sm">
                                    <div class="card-body p-3 border-start border-4 border-warning rounded">
                                        <div class="text-muted small mb-1">Karbantartás alatt</div>
                                        <div class="fs-3 fw-bold text-dark">1 terem</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row g-3">
                            <div class="col-12 col-md-6 col-xl-4">
                                <div class="card h-100 shadow-sm border-0">
                                    <div class="card-body p-4">
                                        <div class="d-grid gap-2">
                                            <a href="/rooms" class="btn btn-outline-secondary">Termek</a>
                                            <a href="/equipment" class="btn btn-outline-secondary">Felszerelések</a>
                                            <a href="/keys" class="btn btn-outline-secondary">Kulcsok</a>
                                            <a href="/roles" class="btn btn-outline-secondary">Szerepkörök</a>
                                            <a href="/maintenancewindows" class="btn btn-outline-secondary">Karbantartási időszakok</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @* <!-- ÜZEMELTETÉSI IGAZGATÓ --> *@
                @if (SelectedRole == "Üzemeltetési igazgató")
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body p-4">
                                <p class="text-muted small mb-4">
                                    A rendszer működésének, kihasználtságának és eseményeinek áttekintése.
                                </p>

                                <div class="d-grid gap-2">
                                    <span class="text-muted small text-center">
                                        Riportok – fejlesztés alatt
                                    </span>
                                    <span class="text-muted small text-center">
                                        Audit logok – fejlesztés alatt
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="container py-5">

            <!-- NYILVÁNOS KEZDŐOLDAL -->
            <div class="bg-white rounded-3 shadow-sm border text-center p-4 p-md-5 mb-4">
                <div class="mb-3">
                    <span class="display-1">🏫</span>
                </div>

                <span class="badge bg-primary-subtle text-primary mb-3">
                    INFORMATIKAI KAR
                </span>

                <h1 class="display-5 fw-bold text-dark">
                    Terem- és Kulcskezelő Rendszer
                </h1>

                <p class="fs-5 text-muted mb-4">
                    PeKeyMngr
                </p>

                <p class="text-secondary mx-auto mb-4" style="max-width: 650px;">
                    A rendszer az egyetemi termek foglalását, a kulcsok kezelését
                    és az üzemeltetési feladatok nyilvántartását támogatja.
                    A funkciók használatához kérjük, jelentkezzen be egyetemi azonosítójával.
                </p>

                <button class="btn btn-primary px-4 py-2"
                        @onclick='() => Nav.NavigateTo("Account/Login")'>
                    Bejelentkezés
                </button>
            </div>

            <!-- INFORMÁCIÓS KÁRTYÁK -->
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <div class="fs-1 mb-3">🔐</div>
                            <h5 class="fw-bold">Kulcskezelés</h5>
                            <p class="text-muted small mb-0">
                                A kulcsok nyilvántartása és kiadásukhoz, átvételükhöz
                                kapcsolódó folyamatok támogatása.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <div class="fs-1 mb-3">📅</div>
                            <h5 class="fw-bold">Teremfoglalás</h5>
                            <p class="text-muted small mb-0">
                                Egyetemi termek és időszakok nyilvántartása,
                                foglalási igények kezelése.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <div class="fs-1 mb-3">📋</div>
                            <h5 class="fw-bold">Üzemeltetés</h5>
                            <p class="text-muted small mb-0">
                                Hibajegyek, karbantartási időszakok és
                                üzemeltetési információk kezelése.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string SelectedRole { get; set; } = "Adminisztrátor";
}