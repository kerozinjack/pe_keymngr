</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool IsRoleLoaded { get; set; }
    private string? ActualRole { get; set; }
    private string? SelectedRole { get; set; }

    // portás kezdőlap
    // Csak az oktató kezdőlapjára vonatkozó, megjelenítési adatok.
    private sealed record TeacherReservationRow(
        Guid ReservationId,
        string RoomName,
        string Building,
        DateTime StartTime,
        DateTime EndTime);

    private List<TeacherReservationRow> TodayTeacherReservations { get; set; } = [];
    private string? TeacherScheduleError { get; set; }

    // Csak a portás kezdőlapjára vonatkozó, megjelenítési adatok.
    private sealed record DashboardKeyRow(
        Guid KeyId,
        string KeyName,
        string ParticipantName,
        DateTime IssuedAtLocal,
        DateTime? DueAtLocal,
        bool IsOverdue,
        bool IsDueEstimated,
        string DueMatchNote);

    private sealed record DashboardMaintenanceRow(
        Guid RoomId,
        string RoomName,
        string Building,
        string Floor,
        DateTime EndTime);

    private List<DashboardKeyRow> ActiveKeyRows { get; set; } = [];
    private List<DashboardMaintenanceRow> ActiveMaintenanceRows { get; set; } = [];
    private int TotalKeyCount { get; set; }
    private int AvailableKeyCount { get; set; }
    private int OverdueKeyCount { get; set; }
    private int TodayReturnCount { get; set; }
    private int TodayReservationCount { get; set; }
    private DateTime? LastDashboardUpdate { get; set; }
    private bool IsDashboardLoading { get; set; }
    private string? DashboardError { get; set; }

    // Adminisztrátori kezdőlap
    private sealed record AdminBuildingRow(string Name, int RoomCount);
    private sealed record AdminMaintenanceRow(
        Guid Id, DateTime StartTime, DateTime EndTime, string RoomNames, bool IsActive);

    private List<AdminBuildingRow> AdminBuildingRows { get; set; } = [];
    private List<AdminMaintenanceRow> AdminMaintenanceRows { get; set; } = [];
    private int AdminRoomCount { get; set; }
    private int AdminEquipmentCount { get; set; }
    private int AdminKeyCount { get; set; }
    private int AdminRoleCount { get; set; }
    private int AdminUserCount { get; set; }
    private int AdminTotalMaintenanceCount { get; set; }
    private int AdminActiveMaintenanceCount { get; set; }
    private DateTime? LastAdminDashboardUpdate { get; set; }
    private bool IsAdminDashboardLoading { get; set; }
    private string? AdminDashboardError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is null)
        {
            IsRoleLoaded = true;
            return;
        }

        AuthenticationState authenticationState = await AuthenticationStateTask;
        ClaimsPrincipal principal = authenticationState.User;

        if (principal.Identity?.IsAuthenticated == true)
        {
            string? userId = principal.FindFirstValue(ClaimTypes.NameIdentifier);

            if (!string.IsNullOrWhiteSpace(userId))
            {
                await using ApplicationDbContext db = await DbFactory.CreateDbContextAsync();
                ApplicationUser? user = await db.Users
                    .AsNoTracking()
                    .Include(u => u.Roles)
                    .FirstOrDefaultAsync(u => u.Id == userId);

                HashSet<string>? roles = user?.Roles
                    .Select(role => role.RoleName)
                    .ToHashSet(StringComparer.Ordinal);

                ActualRole = roles is null ? null
                    : roles.Contains("admin") ? "Adminisztrátor"
                    : roles.Contains("teacher") ? "Oktató / Igénylő"
                    : roles.Contains("janitor") ? "Portás / Operátor"
                    : roles.Contains("Operations Director") ? "Üzemeltetési igazgató"
                    : null;

                // Csak a bejelentkezett oktató mai napon kezdődő foglalásait töltjük be.
                if (ActualRole == "Oktató / Igénylő")
                {
                    try
                    {
                        DateTime today = DateTime.Today;
                        DateTime tomorrow = today.AddDays(1);
                        TodayTeacherReservations = await db.Reservations
                            .AsNoTracking()
                            .Where(reservation =>
                                reservation.RequestedBy.Id == userId &&
                                reservation.StartTime >= today &&
                                reservation.StartTime < tomorrow)
                            .OrderBy(reservation => reservation.StartTime)
                            .Select(reservation => new TeacherReservationRow(
                                reservation.ReservationId,
                                reservation.Room.RoomName,
                                reservation.Room.Building,
                                reservation.StartTime,
                                reservation.EndTime))
                            .ToListAsync();
                    }
                    catch (DbException exception)
                    {
                        // Adatbázishiba esetén nem jelenítünk meg üres foglalási listát.
                        Logger.LogError(exception, "Failed to load today's reservations for user {UserId}", userId);
                        TeacherScheduleError = "Nem sikerült betölteni a mai foglalásokat. Frissítse az oldalt.";
                    }
                }
            }
        }

        SelectedRole = ActualRole;
        IsRoleLoaded = true;

        if (ActualRole == "Portás / Operátor")
        {
            await LoadJanitorDashboardAsync();
        }
        else if (ActualRole == "Adminisztrátor")
        {
            await LoadAdminDashboardAsync();
        }
    }

    private void ResetRoleSelection() => SelectedRole = ActualRole;

    private async Task LoadAdminDashboardAsync()
    {
        if (ActualRole != "Adminisztrátor" || IsAdminDashboardLoading)
        {
            return;
        }

        IsAdminDashboardLoading = true;
        AdminDashboardError = null;

        try
        {
            DateTime now = DateTime.Now;
            await using ApplicationDbContext db = await DbFactory.CreateDbContextAsync();

            List<string> buildings = await db.Rooms
                .AsNoTracking()
                .Select(room => room.Building)
                .ToListAsync();

            List<AdminBuildingRow> buildingRows = buildings
                .GroupBy(building => string.IsNullOrWhiteSpace(building)
                    ? "Nincs megadva"
                    : building.Trim())
                .Select(group => new AdminBuildingRow(group.Key, group.Count()))
                .OrderBy(row => row.Name)
                .ToList();

            // admin statisztikak
            int equipmentCount = await db.Equipments.AsNoTracking().CountAsync();
            int keyCount = await db.Keys.AsNoTracking().CountAsync();
            int roleCount = await db.CustomRoles.AsNoTracking().CountAsync();
            int userCount = await db.Users.AsNoTracking().CountAsync();
            int allMaintenanceCount = await db.MaintenanceWindows.AsNoTracking().CountAsync();
            int activeMaintenanceCount = await db.MaintenanceWindows
                .AsNoTracking()
                .CountAsync(window => window.StartTime <= now && window.EndTime > now);

            // aktuális vagy jövőbeni karbantartások
            List<MaintenanceWindow> maintenanceWindows = await db.MaintenanceWindows
                .AsNoTracking()
                .Include(window => window.AffectedRooms)
                .Where(window => window.EndTime > now)
                .OrderBy(window => window.StartTime > now)
                .ThenBy(window => window.StartTime)
                .ThenBy(window => window.MaintenanceWindowId)
                .Take(5)
                .AsSplitQuery()
                .ToListAsync();

            List<AdminMaintenanceRow> maintenanceRows = maintenanceWindows
                .Select(window => new AdminMaintenanceRow(
                    window.MaintenanceWindowId,
                    window.StartTime,
                    window.EndTime,
                    window.AffectedRooms.Count == 0
                        ? "Nincs megadva terem"
                        : string.Join(", ", window.AffectedRooms
                            .OrderBy(room => room.RoomName)
                            .Select(room => $"{room.Building} / {room.Floor} / {room.RoomName}")),
                    window.StartTime <= now))
                .ToList();

            // uj allapot
            AdminRoomCount = buildings.Count;
            AdminEquipmentCount = equipmentCount;
            AdminKeyCount = keyCount;
            AdminRoleCount = roleCount;
            AdminUserCount = userCount;
            AdminTotalMaintenanceCount = allMaintenanceCount;
            AdminActiveMaintenanceCount = activeMaintenanceCount;
            AdminBuildingRows = buildingRows;
            AdminMaintenanceRows = maintenanceRows;
            LastAdminDashboardUpdate = now;
        }
        catch (Exception)
        {
            AdminDashboardError = "Nem sikerült betölteni az adminisztrátori adatokat. Próbáld újra a frissítést.";
        }
        finally
        {
            IsAdminDashboardLoading = false;
        }
    }

    private async Task LoadJanitorDashboardAsync()
    {
        if (ActualRole != "Portás / Operátor" || IsDashboardLoading)
        {
            return;
        }

        IsDashboardLoading = true;
        DashboardError = null;

        try
        {

            DateTime now = DateTime.Now;
            DateTime today = now.Date;
            DateTime tomorrow = today.AddDays(1);

            // kulcsok out/in
            List<ActiveKeyIssue> activeIssues = await KeyService.GetActiveIssuesAsync();

            await using ApplicationDbContext db = await DbFactory.CreateDbContextAsync();
            int totalKeys = await db.Keys.AsNoTracking().CountAsync();

            DateTime utcStart = TimeZoneInfo.ConvertTimeToUtc(today);
            DateTime utcEnd = TimeZoneInfo.ConvertTimeToUtc(tomorrow);

            int returnsToday = await db.KeyTransactions
                .AsNoTracking()
                .CountAsync(transaction =>
                    transaction.Direction == TransactionDirection.In &&
                    transaction.Timestamp >= utcStart &&
                    transaction.Timestamp < utcEnd);

            int reservationsToday = await db.Reservations
                .AsNoTracking()
                .CountAsync(reservation =>
                    reservation.StartTime < tomorrow &&
                    reservation.EndTime > today);

            DateTime earliestIssueDate = activeIssues.Count == 0
                ? today
                : activeIssues.Min(issue => ToLocalDateTime(issue.IssuedAtUtc)).Date;

            DateTime latestIssueDayEnd = activeIssues.Count == 0
                ? tomorrow
                : activeIssues.Max(issue => ToLocalDateTime(issue.IssuedAtUtc)).Date.AddDays(1);

            List<Reservation> reservations = activeIssues.Count == 0
                ? []
                : await db.Reservations
                    .AsNoTracking()
                    .Include(reservation => reservation.Room)
                    .Include(reservation => reservation.RequestedBy)
                    .Where(reservation =>
                        reservation.StartTime < latestIssueDayEnd &&
                        reservation.EndTime > earliestIssueDate)
                    .AsSplitQuery()
                    .ToListAsync();

            List<DashboardKeyRow> keyRows = [];

            foreach (ActiveKeyIssue issue in activeIssues)
            {
                DateTime issuedAtLocal = ToLocalDateTime(issue.IssuedAtUtc);
                DateTime issueDay = issuedAtLocal.Date;
                DateTime nextIssueDay = issueDay.AddDays(1);

                List<Reservation> sameDayCandidates = reservations
                    .Where(reservation =>
                        reservation.RequestedBy.Id == issue.ParticipantId &&
                        issue.AssignedRoomIds.Contains(reservation.Room.RoomId) &&
                        reservation.StartTime < nextIssueDay &&
                        reservation.EndTime > issueDay)
                    .ToList();

                DateTime? dueAtLocal = null;
                bool isDueEstimated = false;
                string note = string.Empty;

                if (sameDayCandidates.Count == 1)
                {
                    dueAtLocal = sameDayCandidates[0].EndTime.AddMinutes(15);
                }
                else if (sameDayCandidates.Count > 1)
                {
                    Reservation closest = sameDayCandidates
                        .OrderBy(reservation =>
                            Math.Abs((reservation.StartTime - issuedAtLocal).TotalMinutes))
                        .ThenBy(reservation => reservation.StartTime)
                        .First();

                    dueAtLocal = closest.EndTime.AddMinutes(15);
                    isDueEstimated = true;
                    note = $"{sameDayCandidates.Count} lehetséges foglalás";
                }
                else
                {
                    note = "Nincs illeszkedő foglalás a kiadás napján";
                }

                keyRows.Add(new DashboardKeyRow(
                    issue.KeyId,
                    issue.KeyName,
                    issue.ParticipantName,
                    issuedAtLocal,
                    dueAtLocal,
                    dueAtLocal is not null && !isDueEstimated && now > dueAtLocal.Value,
                    isDueEstimated,
                    note));
            }

            // aktiv MaintenanceWindow alatt levo terem
            List<MaintenanceWindow> maintenanceWindows = await db.MaintenanceWindows
                .AsNoTracking()
                .Include(window => window.AffectedRooms)
                .Where(window => window.StartTime <= now && window.EndTime > now)
                .AsSplitQuery()
                .ToListAsync();

            List<DashboardMaintenanceRow> maintenanceRows = maintenanceWindows
                .SelectMany(window => window.AffectedRooms.Select(room => new DashboardMaintenanceRow(
                    room.RoomId,
                    room.RoomName,
                    room.Building,
                    room.Floor,
                    window.EndTime)))
                .GroupBy(row => row.RoomId)
                .Select(group => group.OrderByDescending(row => row.EndTime).First())
                .OrderBy(row => row.Building)
                .ThenBy(row => row.Floor)
                .ThenBy(row => row.RoomName)
                .ToList();

            ActiveKeyRows = keyRows
                .OrderByDescending(row => row.IsOverdue)
                .ThenBy(row => row.IssuedAtLocal)
                .ToList();
            ActiveMaintenanceRows = maintenanceRows;
            TotalKeyCount = totalKeys;
            AvailableKeyCount = Math.Max(0, totalKeys - activeIssues.Count);
            OverdueKeyCount = keyRows.Count(row => row.IsOverdue);
            TodayReturnCount = returnsToday;
            TodayReservationCount = reservationsToday;
            LastDashboardUpdate = now;
        }
        catch (Exception)
        {
            // Nem mutatunk fiktív nullákat adatbázishiba esetén.
            DashboardError = "Nem sikerült betölteni a portás dashboard adatait. Próbáld újra a frissítést.";
        }
        finally
        {
            IsDashboardLoading = false;
        }
    }

    private static DateTime ToLocalDateTime(DateTime utcTimestamp)
    {
        // Az SQLite-ból kiolvasott DateTime.Kind lehet Unspecified.
        // A KeyManagementService a kulcstranzakciókat DateTime.UtcNow-val menti.
        DateTime correctlyMarkedUtc = DateTime.SpecifyKind(utcTimestamp, DateTimeKind.Utc);
        return correctlyMarkedUtc.ToLocalTime();
    }
}
