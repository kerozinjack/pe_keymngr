@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Data
@using PeKeyMngr.Models
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject KeyManagementService KeyService

<PageTitle>Kezdőlap – Terem- és kulcskezelő rendszer</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="container-fluid py-4">

            <!-- FEJLÉC -->
            <div class="mb-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <span class="badge bg-primary-subtle text-primary mb-2">
                            INFORMATIKAI KAR
                        </span>
                        <h2 class="fw-bold mb-1">Üdvözöljük a rendszerben!</h2>
                        <p class="text-muted mb-0">
                            Terem- és kulcskezelő rendszer – válassza ki a használni kívánt funkciót.
                        </p>
                    </div>
                    <div class="text-md-end">
                        <span class="text-muted small">Központi kezelőfelület</span>
                        <div class="fw-semibold">PeKeyMngr</div>
                    </div>
                </div>
            </div>

            <!-- AKTUÁLIS SZEREPKÖR -->
            @if (!IsRoleLoaded)
            {
                <div class="alert alert-info">Felhasználói szerepkör betöltése...</div>
            }
            else if (SelectedRole is null)
            {
                <div class="alert alert-warning">
                    A bejelentkezett felhasználóhoz nem található támogatott szerepkör.
                    Ellenőrizd a felhasználó szerepkör-hozzárendelését az adatbázisban.
                </div>
            }
            else
            {
                <div class="mb-3">
                    <h5 class="fw-semibold mb-1">@SelectedRole</h5>
                    <p class="text-muted small mb-0">
                        @if (ActualRole == SelectedRole)
                        {
                            <span>A bejelentkezett felhasználóhoz tartozó funkciók.</span>
                        }
                        else
                        {
                            <span>Tesztelésre kiválasztott nézet (nem a saját szerepköröd).</span>
                        }
                    </p>
                </div>
            }

            <div class="row g-4">

                <!-- OKTATÓ -->
                @if (SelectedRole == "Oktató / Igénylő")
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body p-4">
                                <p class="text-muted small mb-4">
                                    Termek és idősávok foglalása, valamint speciális igények megadása.
                                </p>

                                <div class="d-grid gap-2">
                                    <a href="/reservations" class="btn btn-outline-primary">
                                        Foglalások megtekintése
                                    </a>
                                    <span class="text-muted small text-center">
                                        Új foglalás – fejlesztés alatt
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- PORTÁS: VALÓDI ADATOKBÓL ÉPÍTETT DASHBOARD -->
                @if (SelectedRole == "Portás / Operátor")
                {
                    <div class="col-12">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                            <div>
                                <h4 class="fw-bold mb-1">Kulcskezelési áttekintés</h4>
                                <p class="text-muted mb-0">
                                    Kiadott kulcsok, visszavételek és a portaszolgálat aktuális teendői.
                                </p>
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                @if (LastDashboardUpdate is not null)
                                {
                                    <span class="text-muted small">
                                        Frissítve: @(LastDashboardUpdate.Value.ToString("yyyy.MM.dd. HH:mm:ss"))
                                    </span>
                                }
                                <button type="button" class="btn btn-outline-secondary"
                                        disabled="@IsDashboardLoading" @onclick="LoadJanitorDashboardAsync">
                                    @(IsDashboardLoading ? "Frissítés..." : "Adatok frissítése")
                                </button>
                                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle px-3 py-2">
                                    Portás / Operátor
                                </span>
                            </div>
                        </div>

                        @if (IsDashboardLoading && LastDashboardUpdate is null)
                        {
                            <div class="alert alert-info" role="status">A portás dashboard betöltése folyamatban...</div>
                        }
                        else if (DashboardError is not null)
                        {
                            <div class="alert alert-danger" role="alert">
                                @DashboardError
                            </div>
                        }
                        else
                        {
                            <!-- Valós összesített statisztikák -->
                            <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3 mb-4">
                                <div class="col">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-3 border-start border-4 border-primary rounded">
                                            <div class="text-muted small mb-2">Kiadott kulcsok</div>
                                            <div class="fs-3 fw-bold">@ActiveKeyRows.Count <span class="fs-6 text-muted fw-normal">/ @TotalKeyCount</span></div>
                                            <div class="text-muted small">Jelenleg kint lévő fizikai kulcsok</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-3 border-start border-4 border-success rounded">
                                            <div class="text-muted small mb-2">Elérhető kulcsok</div>
                                            <div class="fs-3 fw-bold">@AvailableKeyCount</div>
                                            <div class="text-muted small">Jelenleg a portán lévő kulcsok</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-3 border-start border-4 border-danger rounded">
                                            <div class="text-muted small mb-2">Késésben lévő kulcsok</div>
                                            <div class="fs-3 fw-bold text-danger">@OverdueKeyCount</div>
                                            <div class="text-muted small">Foglalás vége + 15 perc után</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-3 border-start border-4 border-info rounded">
                                            <div class="text-muted small mb-2">Mai visszavételek</div>
                                            <div class="fs-3 fw-bold">@TodayReturnCount</div>
                                            <div class="text-muted small">Ma rögzített visszavételi műveletek</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-3 border-start border-4 border-secondary rounded">
                                            <div class="text-muted small mb-2">Mai foglalások</div>
                                            <div class="fs-3 fw-bold">@TodayReservationCount</div>
                                            <div class="text-muted small">A mai napot érintő foglalások</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-3 border-start border-4 border-warning rounded">
                                            <div class="text-muted small mb-2">Karbantartás alatt</div>
                                            <div class="fs-3 fw-bold">@ActiveMaintenanceRows.Count <span class="fs-6 text-muted fw-normal">terem</span></div>
                                            <div class="text-muted small">Aktuálisan érintett termek</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- MINDEN aktív kiadás, a korábbi napokról maradtak is -->
                            <div class="card border-0 shadow-sm mb-4">
                                <div class="card-header bg-body border-bottom py-3 px-4">
                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                        <div>
                                            <h5 class="fw-bold mb-1">Aktív kulcskiadások</h5>
                                            <p class="text-muted small mb-0">Minden jelenleg kiadott kulcs, a kiadás napjától függetlenül.</p>
                                        </div>
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis">
                                            @ActiveKeyRows.Count aktív
                                        </span>
                                    </div>
                                </div>
                                <div class="card-body p-0">
                                    @if (ActiveKeyRows.Count == 0)
                                    {
                                        <div class="text-center text-muted py-4 px-3">
                                            Jelenleg nincs kiadott kulcs.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-hover align-middle mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th class="ps-4">Kulcs</th>
                                                        <th>Átvevő</th>
                                                        <th>Kiadás időpontja</th>
                                                        <th>Visszavételi határ</th>
                                                        <th>Állapot</th>
                                                        <th class="text-end pe-4">Művelet</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (DashboardKeyRow issue in ActiveKeyRows)
                                                    {
                                                        <tr @key="issue.KeyId">
                                                            <td class="ps-4 fw-semibold">@issue.KeyName</td>
                                                            <td>@issue.ParticipantName</td>
                                                            <td class="text-nowrap">@(issue.IssuedAtLocal.ToString("yyyy.MM.dd. HH:mm"))</td>
                                                            <td class="text-nowrap">
                                                                @if (issue.DueAtLocal is not null)
                                                                {
                                                                    <div>@(issue.DueAtLocal.Value.ToString("yyyy.MM.dd. HH:mm"))</div>
                                                                    @if (issue.IsDueEstimated)
                                                                    {
                                                                        <div class="small text-warning-emphasis">Becsült határidő</div>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">Nem meghatározható</span>
                                                                }
                                                                @if (!string.IsNullOrEmpty(issue.DueMatchNote))
                                                                {
                                                                    <div class="small text-muted">@issue.DueMatchNote</div>
                                                                }
                                                            </td>
                                                            <td>
                                                                @if (issue.IsOverdue)
                                                                {
                                                                    <span class="badge bg-danger-subtle text-danger-emphasis">Késésben</span>
                                                                }
                                                                else if (issue.IsDueEstimated)
                                                                {
                                                                    <span class="badge bg-warning-subtle text-warning-emphasis">Kiadva · becsült határidő</span>
                                                                }
                                                                else if (issue.DueAtLocal is null)
                                                                {
                                                                    <span class="badge bg-secondary-subtle text-secondary-emphasis">Kiadva · nem párosítható</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-success-subtle text-success-emphasis">Kiadva</span>
                                                                }
                                                            </td>
                                                            <td class="text-end pe-4">
                                                                <a href="/keymanagement" class="btn btn-sm btn-outline-primary">
                                                                    Kulcskezelés
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                                <div class="card-footer bg-body border-top px-4 py-3 text-muted small">
                                    A visszavétel a Kulcskezelés oldalon végezhető el. A PIN-kódos jóváhagyás továbbra is fejlesztés alatt áll.
                                    A visszavételi határidőt a foglalás vége + 15 perc alapján számoljuk.
                                    Több megfelelő foglalás esetén becsült időpont jelenik meg, amelyből nem számolunk biztos késést.
                                </div>
                            </div>

                            <div class="row g-3">
                                <!-- GYORSMŰVELETEK -->
                                <div class="col-12 col-lg-7">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-4">
                                            <h5 class="fw-bold mb-1">Gyorsműveletek</h5>
                                            <p class="text-muted small mb-4">A portaszolgálat leggyakrabban használt funkciói.</p>
                                            <div class="d-grid gap-3">
                                                <a href="/keymanagement" class="btn btn-primary btn-lg py-3 fw-semibold">
                                                    Kulcskezelés – kiadás és visszavétel
                                                </a>
                                                <a href="/issuetickets" class="btn btn-outline-secondary py-3">
                                                    Hibajegyek kezelése
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Csak az azonosítható késő kulcsok és aktív karbantartások -->
                                <div class="col-12 col-lg-5">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-4">
                                            <h5 class="fw-bold mb-1">Figyelmeztetések</h5>
                                            <p class="text-muted small mb-4">Késő kulcsok és jelenleg karbantartás alatt álló termek.</p>

                                            @if (OverdueKeyCount == 0 && ActiveMaintenanceRows.Count == 0)
                                            {
                                                <div class="alert alert-success mb-0" role="status">
                                                    Nincs aktív figyelmeztetés.
                                                </div>
                                            }
                                            else
                                            {
                                                @foreach (DashboardKeyRow lateKey in ActiveKeyRows.Where(issue => issue.IsOverdue))
                                                {
                                                    <div class="alert alert-danger mb-3" role="alert" @key="lateKey.KeyId">
                                                        <div class="fw-semibold">Késésben: @lateKey.KeyName</div>
                                                        <div class="small">Átvevő: @lateKey.ParticipantName</div>
                                                        <div class="small">Visszavételi határ: @(lateKey.DueAtLocal?.ToString("yyyy.MM.dd. HH:mm"))</div>
                                                    </div>
                                                }
                                                @foreach (DashboardMaintenanceRow maintenance in ActiveMaintenanceRows)
                                                {
                                                    <div class="alert alert-warning mb-3" role="alert" @key="maintenance.RoomId">
                                                        <div class="fw-semibold">Karbantartás alatt: @maintenance.RoomName</div>
                                                        <div class="small">@maintenance.Building / @maintenance.Floor</div>
                                                        <div class="small">Várható vég: @(maintenance.EndTime.ToString("yyyy.MM.dd. HH:mm"))</div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }


                <!-- ADMINISZTRÁTOR -->
                @if (SelectedRole == "Adminisztrátor")
                {
                    <div class="col-12">
                        <div class="mb-4">
                            <h4 class="fw-bold mb-1">Rendszeráttekintés</h4>
                            <p class="text-muted mb-0">
                                A rendszer aktuális állapotának és legfontosabb adatainak áttekintése.
                            </p>
                        </div>

                        <!-- IDEIGLENES TESZTADATOK
                             TODO: Később valódi adatbázis-lekérdezésekre kell cserélni. -->
                        <div class="row g-3 mb-4">
                            <div class="col-6 col-xl-3">
                                <div class="card h-100 border-0 shadow-sm">
                                    <div class="card-body p-3 border-start border-4 border-primary rounded">
                                        <div class="text-muted small mb-1">Kiadott kulcsok</div>
                                        <div class="fs-3 fw-bold text-dark">
                                            12 <span class="fs-6 text-muted fw-normal">/ 48</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6 col-xl-3">
                                <div class="card h-100 border-0 shadow-sm">
                                    <div class="card-body p-3 border-start border-4 border-success rounded">
                                        <div class="text-muted small mb-1">Mai foglalások</div>
                                        <div class="fs-3 fw-bold text-dark">24</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6 col-xl-3">
                                <div class="card h-100 border-0 shadow-sm">
                                    <div class="card-body p-3 border-start border-4 border-danger rounded">
                                        <div class="text-muted small mb-1">Késésben lévő kulcsok</div>
                                        <div class="fs-3 fw-bold text-danger">2</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6 col-xl-3">
                                <div class="card h-100 border-0 shadow-sm">
                                    <div class="card-body p-3 border-start border-4 border-warning rounded">
                                        <div class="text-muted small mb-1">Karbantartás alatt</div>
                                        <div class="fs-3 fw-bold text-dark">1 terem</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row g-3">
                            <div class="col-12 col-md-6 col-xl-4">
                                <div class="card h-100 shadow-sm border-0">
                                    <div class="card-body p-4">
                                        <div class="d-grid gap-2">
                                            <a href="/rooms" class="btn btn-outline-secondary">Termek</a>
                                            <a href="/equipment" class="btn btn-outline-secondary">Felszerelések</a>
                                            <a href="/keys" class="btn btn-outline-secondary">Kulcsok</a>
                                            <a href="/roles" class="btn btn-outline-secondary">Szerepkörök</a>
                                            <a href="/maintenancewindows" class="btn btn-outline-secondary">Karbantartási időszakok</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @* <!-- ÜZEMELTETÉSI IGAZGATÓ --> *@
                @if (SelectedRole == "Üzemeltetési igazgató")
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body p-4">
                                <p class="text-muted small mb-4">
                                    A rendszer működésének, kihasználtságának és eseményeinek áttekintése.
                                </p>

                                <div class="d-grid gap-2">
                                    <span class="text-muted small text-center">
                                        Riportok – fejlesztés alatt
                                    </span>
                                    <span class="text-muted small text-center">
                                        Audit logok – fejlesztés alatt
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="container py-5">

            <!-- NYILVÁNOS KEZDŐOLDAL -->
            <div class="bg-white rounded-3 shadow-sm border text-center p-4 p-md-5 mb-4">
                <div class="mb-3">
                    <span class="display-1">🏫</span>
                </div>

                <span class="badge bg-primary-subtle text-primary mb-3">
                    INFORMATIKAI KAR
                </span>

                <h1 class="display-5 fw-bold text-dark">
                    Terem- és Kulcskezelő Rendszer
                </h1>

                <p class="fs-5 text-muted mb-4">
                    PeKeyMngr
                </p>

                <p class="text-secondary mx-auto mb-4" style="max-width: 650px;">
                    A rendszer az egyetemi termek foglalását, a kulcsok kezelését
                    és az üzemeltetési feladatok nyilvántartását támogatja.
                    A funkciók használatához kérjük, jelentkezzen be egyetemi azonosítójával.
                </p>

                <button class="btn btn-primary px-4 py-2"
                        @onclick='() => Nav.NavigateTo("Account/Login")'>
                    Bejelentkezés
                </button>
            </div>

            <!-- INFORMÁCIÓS KÁRTYÁK -->
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <div class="fs-1 mb-3">🔐</div>
                            <h5 class="fw-bold">Kulcskezelés</h5>
                            <p class="text-muted small mb-0">
                                A kulcsok nyilvántartása és kiadásukhoz, átvételükhöz
                                kapcsolódó folyamatok támogatása.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <div class="fs-1 mb-3">📅</div>
                            <h5 class="fw-bold">Teremfoglalás</h5>
                            <p class="text-muted small mb-0">
                                Egyetemi termek és időszakok nyilvántartása,
                                foglalási igények kezelése.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <div class="fs-1 mb-3">📋</div>
                            <h5 class="fw-bold">Üzemeltetés</h5>
                            <p class="text-muted small mb-0">
                                Hibajegyek, karbantartási időszakok és
                                üzemeltetési információk kezelése.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool IsRoleLoaded { get; set; }
    private string? ActualRole { get; set; }
    private string? SelectedRole { get; set; }

    // Csak a portás kezdőlapjára vonatkozó, megjelenítési adatok.
    private sealed record DashboardKeyRow(
        Guid KeyId,
        string KeyName,
        string ParticipantName,
        DateTime IssuedAtLocal,
        DateTime? DueAtLocal,
        bool IsOverdue,
        bool IsDueEstimated,
        string DueMatchNote);

    private sealed record DashboardMaintenanceRow(
        Guid RoomId,
        string RoomName,
        string Building,
        string Floor,
        DateTime EndTime);

    private List<DashboardKeyRow> ActiveKeyRows { get; set; } = [];
    private List<DashboardMaintenanceRow> ActiveMaintenanceRows { get; set; } = [];
    private int TotalKeyCount { get; set; }
    private int AvailableKeyCount { get; set; }
    private int OverdueKeyCount { get; set; }
    private int TodayReturnCount { get; set; }
    private int TodayReservationCount { get; set; }
    private DateTime? LastDashboardUpdate { get; set; }
    private bool IsDashboardLoading { get; set; }
    private string? DashboardError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is null)
        {
            IsRoleLoaded = true;
            return;
        }

        AuthenticationState authenticationState = await AuthenticationStateTask;
        ClaimsPrincipal principal = authenticationState.User;

        if (principal.Identity?.IsAuthenticated == true)
        {
            string? userId = principal.FindFirstValue(ClaimTypes.NameIdentifier);

            if (!string.IsNullOrWhiteSpace(userId))
            {
                await using ApplicationDbContext db = await DbFactory.CreateDbContextAsync();
                ApplicationUser? user = await db.Users
                    .AsNoTracking()
                    .Include(u => u.Roles)
                    .FirstOrDefaultAsync(u => u.Id == userId);

                HashSet<string>? roles = user?.Roles
                    .Select(role => role.RoleName)
                    .ToHashSet(StringComparer.Ordinal);

                ActualRole = roles is null ? null
                    : roles.Contains("admin") ? "Adminisztrátor"
                    : roles.Contains("teacher") ? "Oktató / Igénylő"
                    : roles.Contains("janitor") ? "Portás / Operátor"
                    : roles.Contains("Operations Director") ? "Üzemeltetési igazgató"
                    : null;
            }
        }

        SelectedRole = ActualRole;
        IsRoleLoaded = true;

        // A portás dashboard adatait csak a tényleges portási szerepkörnél töltjük.
        if (ActualRole == "Portás / Operátor")
        {
            await LoadJanitorDashboardAsync();
        }
    }

    private void ResetRoleSelection() => SelectedRole = ActualRole;

    private async Task LoadJanitorDashboardAsync()
    {
        if (ActualRole != "Portás / Operátor" || IsDashboardLoading)
        {
            return;
        }

        IsDashboardLoading = true;
        DashboardError = null;

        try
        {
           
            DateTime now = DateTime.Now;
            DateTime today = now.Date;
            DateTime tomorrow = today.AddDays(1);

            // A meglévő KeyManagementService kezeli a fizikai kulcsok Out/In állapotát,
            // Master kulcsok esetében is. A korábbi napok aktív kiadásai is benne vannak.
            List<ActiveKeyIssue> activeIssues = await KeyService.GetActiveIssuesAsync();

            await using ApplicationDbContext db = await DbFactory.CreateDbContextAsync();
            int totalKeys = await db.Keys.AsNoTracking().CountAsync();

            DateTime utcStart = TimeZoneInfo.ConvertTimeToUtc(today);
            DateTime utcEnd = TimeZoneInfo.ConvertTimeToUtc(tomorrow);

            int returnsToday = await db.KeyTransactions
                .AsNoTracking()
                .CountAsync(transaction =>
                    transaction.Direction == TransactionDirection.In &&
                    transaction.Timestamp >= utcStart &&
                    transaction.Timestamp < utcEnd);

            int reservationsToday = await db.Reservations
                .AsNoTracking()
                .CountAsync(reservation =>
                    reservation.StartTime < tomorrow &&
                    reservation.EndTime > today);

            DateTime earliestIssueDate = activeIssues.Count == 0
                ? today
                : activeIssues.Min(issue => ToLocalDateTime(issue.IssuedAtUtc)).Date;

            DateTime latestIssueDayEnd = activeIssues.Count == 0
                ? tomorrow
                : activeIssues.Max(issue => ToLocalDateTime(issue.IssuedAtUtc)).Date.AddDays(1);

            List<Reservation> reservations = activeIssues.Count == 0
                ? []
                : await db.Reservations
                    .AsNoTracking()
                    .Include(reservation => reservation.Room)
                    .Include(reservation => reservation.RequestedBy)
                    .Where(reservation =>
                        reservation.StartTime < latestIssueDayEnd &&
                        reservation.EndTime > earliestIssueDate)
                    .AsSplitQuery()
                    .ToListAsync();

            List<DashboardKeyRow> keyRows = [];

            foreach (ActiveKeyIssue issue in activeIssues)
            {
                DateTime issuedAtLocal = ToLocalDateTime(issue.IssuedAtUtc);
                DateTime issueDay = issuedAtLocal.Date;
                DateTime nextIssueDay = issueDay.AddDays(1);

                List<Reservation> sameDayCandidates = reservations
                    .Where(reservation =>
                        reservation.RequestedBy.Id == issue.ParticipantId &&
                        issue.AssignedRoomIds.Contains(reservation.Room.RoomId) &&
                        reservation.StartTime < nextIssueDay &&
                        reservation.EndTime > issueDay)
                    .ToList();

                DateTime? dueAtLocal = null;
                bool isDueEstimated = false;
                string note = string.Empty;

                if (sameDayCandidates.Count == 1)
                {
                    dueAtLocal = sameDayCandidates[0].EndTime.AddMinutes(15);
                }
                else if (sameDayCandidates.Count > 1)
                {
                    Reservation closest = sameDayCandidates
                        .OrderBy(reservation =>
                            Math.Abs((reservation.StartTime - issuedAtLocal).TotalMinutes))
                        .ThenBy(reservation => reservation.StartTime)
                        .First();

                    dueAtLocal = closest.EndTime.AddMinutes(15);
                    isDueEstimated = true;
                    note = $"{sameDayCandidates.Count} lehetséges foglalás";
                }
                else
                {
                    note = "Nincs illeszkedő foglalás a kiadás napján";
                }

                keyRows.Add(new DashboardKeyRow(
                    issue.KeyId,
                    issue.KeyName,
                    issue.ParticipantName,
                    issuedAtLocal,
                    dueAtLocal,
                    dueAtLocal is not null && !isDueEstimated && now > dueAtLocal.Value,
                    isDueEstimated,
                    note));
            }

            // Karbantartás alatt csak az a terem van, amelyet egy MOST aktív
            // MaintenanceWindow érint. Több ablak ugyanarra a teremre egy figyelmeztetés.
            List<MaintenanceWindow> maintenanceWindows = await db.MaintenanceWindows
                .AsNoTracking()
                .Include(window => window.AffectedRooms)
                .Where(window => window.StartTime <= now && window.EndTime > now)
                .AsSplitQuery()
                .ToListAsync();

            List<DashboardMaintenanceRow> maintenanceRows = maintenanceWindows
                .SelectMany(window => window.AffectedRooms.Select(room => new DashboardMaintenanceRow(
                    room.RoomId,
                    room.RoomName,
                    room.Building,
                    room.Floor,
                    window.EndTime)))
                .GroupBy(row => row.RoomId)
                .Select(group => group.OrderByDescending(row => row.EndTime).First())
                .OrderBy(row => row.Building)
                .ThenBy(row => row.Floor)
                .ThenBy(row => row.RoomName)
                .ToList();

            // Csak teljes siker esetén írjuk felül a képernyő adatállapotát.
            ActiveKeyRows = keyRows
                .OrderByDescending(row => row.IsOverdue)
                .ThenBy(row => row.IssuedAtLocal)
                .ToList();
            ActiveMaintenanceRows = maintenanceRows;
            TotalKeyCount = totalKeys;
            AvailableKeyCount = Math.Max(0, totalKeys - activeIssues.Count);
            OverdueKeyCount = keyRows.Count(row => row.IsOverdue);
            TodayReturnCount = returnsToday;
            TodayReservationCount = reservationsToday;
            LastDashboardUpdate = now;
        }
        catch (Exception)
        {
            // Nem mutatunk fiktív nullákat adatbázishiba esetén.
            DashboardError = "Nem sikerült betölteni a portás dashboard adatait. Próbáld újra a frissítést.";
        }
        finally
        {
            IsDashboardLoading = false;
        }
    }

    private static DateTime ToLocalDateTime(DateTime utcTimestamp)
    {
        // Az SQLite-ból kiolvasott DateTime.Kind lehet Unspecified.
        // A KeyManagementService a kulcstranzakciókat DateTime.UtcNow-val menti.
        DateTime correctlyMarkedUtc = DateTime.SpecifyKind(utcTimestamp, DateTimeKind.Utc);
        return correctlyMarkedUtc.ToLocalTime();
    }
}
