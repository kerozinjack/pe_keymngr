@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using System.Data.Common
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Data
@using PeKeyMngr.Models
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject KeyManagementService KeyService
@inject ILogger<Home> Logger

<PageTitle>Kezdőlap – Terem- és kulcskezelő rendszer</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="container-fluid py-4">

            <!-- FEJLÉC -->
            <div class="mb-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <span class="badge bg-primary-subtle text-primary mb-2">
                            INFORMATIKAI KAR
                        </span>
                        <h2 class="fw-bold mb-1">Üdvözöljük a rendszerben!</h2>
                        <p class="text-muted mb-0">
                            Terem- és kulcskezelő rendszer – válassza ki a használni kívánt funkciót.
                        </p>
                    </div>
                    <div class="text-md-end">
                        <span class="text-muted small">Központi kezelőfelület</span>
                        <div class="fw-semibold">PeKeyMngr</div>
                    </div>
                </div>
            </div>

            <!-- AKTUÁLIS SZEREPKÖR -->
            @if (!IsRoleLoaded)
            {
                <div class="alert alert-info">Felhasználói szerepkör betöltése...</div>
            }
            else if (SelectedRole is null)
            {
                <div class="alert alert-warning">
                    A bejelentkezett felhasználóhoz nem található támogatott szerepkör.
                    Ellenőrizd a felhasználó szerepkör-hozzárendelését az adatbázisban.
                </div>
            }
            else
            {
                <div class="mb-3">
                    <h5 class="fw-semibold mb-1">@SelectedRole</h5>
                    <p class="text-muted small mb-0">
                        @if (ActualRole == SelectedRole)
                        {
                            <span>A bejelentkezett felhasználóhoz tartozó funkciók.</span>
                        }
                        else
                        {
                            <span>Tesztelésre kiválasztott nézet (nem a saját szerepköröd).</span>
                        }
                    </p>
                </div>
            }

            <div class="row g-4">

                <!-- OKTATÓ -->
                @if (SelectedRole == "Oktató / Igénylő")
                {
                    <!-- A BEJELENTKEZETT OKTATÓ MAI FOGLALÁSAI -->
                    <div class="col-12">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-body border-bottom py-3 px-4">
                                <h5 class="fw-bold mb-0">Mai foglalásaim</h5>
                            </div>
                            <div class="card-body p-0">
                                @if (TeacherScheduleError is not null)
                                {
                                    <div class="alert alert-danger m-3" role="alert">@TeacherScheduleError</div>
                                }
                                else if (TodayTeacherReservations.Count == 0)
                                {
                                    <div class="text-muted py-4 px-4">Ma nincs foglalása.</div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="ps-4" scope="col">Terem</th>
                                                    <th scope="col">Épület</th>
                                                    <th scope="col">Kezdés</th>
                                                    <th scope="col">Befejezés</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (TeacherReservationRow reservation in TodayTeacherReservations)
                                                {
                                                    <tr @key="reservation.ReservationId">
                                                        <td class="ps-4">@reservation.RoomName</td>
                                                        <td>@reservation.Building</td>
                                                        <td>@reservation.StartTime.ToString("yyyy.MM.dd. HH:mm")</td>
                                                        <td>@reservation.EndTime.ToString("yyyy.MM.dd. HH:mm")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body p-4">
                                <p class="text-muted small mb-4">
                                    Termek és idősávok foglalása, valamint speciális igények megadása.
                                </p>

                                <div class="d-grid gap-2">
                                    <a href="/reservations" class="btn btn-outline-primary">
                                        Foglalások megtekintése
                                    </a>
                                    <a href="/reservations/booking" class="btn btn-outline-primary">
                                        Új foglalás
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- PORTÁS -->
                @if (SelectedRole == "Portás / Operátor")
                {
                    <div class="col-12">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                            <div>
                                <h4 class="fw-bold mb-1">Kulcskezelési áttekintés</h4>
                                <p class="text-muted mb-0">
                                    Kiadott kulcsok, visszavételek és a portaszolgálat aktuális teendői.
                                </p>
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                @if (LastDashboardUpdate is not null)
                                {
                                    <span class="text-muted small">
                                        Frissítve: @(LastDashboardUpdate.Value.ToString("yyyy.MM.dd. HH:mm:ss"))
                                    </span>
                                }
                                <button type="button" class="btn btn-outline-secondary"
                                        disabled="@IsDashboardLoading" @onclick="LoadJanitorDashboardAsync">
                                    @(IsDashboardLoading ? "Frissítés..." : "Adatok frissítése")
                                </button>
                                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle px-3 py-2">
                                    Portás / Operátor
                                </span>
                            </div>
                        </div>

                        @if (IsDashboardLoading && LastDashboardUpdate is null)
                        {
                            <div class="alert alert-info" role="status">A portás dashboard betöltése folyamatban...</div>
                        }
                        else if (DashboardError is not null)
                        {
                            <div class="alert alert-danger" role="alert">
                                @DashboardError
                            </div>
                        }
                        else
                        {
                            <!-- statisztikák -->
                            <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3 mb-4">
                                <div class="col">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-3 border-start border-4 border-primary rounded">
                                            <div class="text-muted small mb-2">Kiadott kulcsok</div>
                                            <div class="fs-3 fw-bold">@ActiveKeyRows.Count <span class="fs-6 text-muted fw-normal">/ @TotalKeyCount</span></div>
                                            <div class="text-muted small">Jelenleg kint lévő fizikai kulcsok</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-3 border-start border-4 border-success rounded">
                                            <div class="text-muted small mb-2">Elérhető kulcsok</div>
                                            <div class="fs-3 fw-bold">@AvailableKeyCount</div>
                                            <div class="text-muted small">Jelenleg a portán lévő kulcsok</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-3 border-start border-4 border-danger rounded">
                                            <div class="text-muted small mb-2">Késésben lévő kulcsok</div>
                                            <div class="fs-3 fw-bold text-danger">@OverdueKeyCount</div>
                                            <div class="text-muted small">Foglalás vége + 15 perc után</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-3 border-start border-4 border-info rounded">
                                            <div class="text-muted small mb-2">Mai visszavételek</div>
                                            <div class="fs-3 fw-bold">@TodayReturnCount</div>
                                            <div class="text-muted small">Ma rögzített visszavételi műveletek</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-3 border-start border-4 border-secondary rounded">
                                            <div class="text-muted small mb-2">Mai foglalások</div>
                                            <div class="fs-3 fw-bold">@TodayReservationCount</div>
                                            <div class="text-muted small">A mai napot érintő foglalások</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-3 border-start border-4 border-warning rounded">
                                            <div class="text-muted small mb-2">Karbantartás alatt</div>
                                            <div class="fs-3 fw-bold">@ActiveMaintenanceRows.Count <span class="fs-6 text-muted fw-normal">terem</span></div>
                                            <div class="text-muted small">Aktuálisan érintett termek</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- MINDEN aktív kiadás, a korábbi napokról maradtak is -->
                            <div class="card border-0 shadow-sm mb-4">
                                <div class="card-header bg-body border-bottom py-3 px-4">
                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                        <div>
                                            <h5 class="fw-bold mb-1">Aktív kulcskiadások</h5>
                                            <p class="text-muted small mb-0">Minden jelenleg kiadott kulcs, a kiadás napjától függetlenül.</p>
                                        </div>
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis">
                                            @ActiveKeyRows.Count aktív
                                        </span>
                                    </div>
                                </div>
                                <div class="card-body p-0">
                                    @if (ActiveKeyRows.Count == 0)
                                    {
                                        <div class="text-center text-muted py-4 px-3">
                                            Jelenleg nincs kiadott kulcs.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-hover align-middle mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th class="ps-4">Kulcs</th>
                                                        <th>Átvevő</th>
                                                        <th>Kiadás időpontja</th>
                                                        <th>Visszavételi határ</th>
                                                        <th>Állapot</th>
                                                        <th class="text-end pe-4">Művelet</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (DashboardKeyRow issue in ActiveKeyRows)
                                                    {
                                                        <tr @key="issue.KeyId">
                                                            <td class="ps-4 fw-semibold">@issue.KeyName</td>
                                                            <td>@issue.ParticipantName</td>
                                                            <td class="text-nowrap">@(issue.IssuedAtLocal.ToString("yyyy.MM.dd. HH:mm"))</td>
                                                            <td class="text-nowrap">
                                                                @if (issue.DueAtLocal is not null)
                                                                {
                                                                    <div>@(issue.DueAtLocal.Value.ToString("yyyy.MM.dd. HH:mm"))</div>
                                                                    @if (issue.IsDueEstimated)
                                                                    {
                                                                        <div class="small text-warning-emphasis">Becsült határidő</div>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">Nem meghatározható</span>
                                                                }
                                                                @if (!string.IsNullOrEmpty(issue.DueMatchNote))
                                                                {
                                                                    <div class="small text-muted">@issue.DueMatchNote</div>
                                                                }
                                                            </td>
                                                            <td>
                                                                @if (issue.IsOverdue)
                                                                {
                                                                    <span class="badge bg-danger-subtle text-danger-emphasis">Késésben</span>
                                                                }
                                                                else if (issue.IsDueEstimated)
                                                                {
                                                                    <span class="badge bg-warning-subtle text-warning-emphasis">Kiadva · becsült határidő</span>
                                                                }
                                                                else if (issue.DueAtLocal is null)
                                                                {
                                                                    <span class="badge bg-secondary-subtle text-secondary-emphasis">Kiadva · nem párosítható</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-success-subtle text-success-emphasis">Kiadva</span>
                                                                }
                                                            </td>
                                                            <td class="text-end pe-4">
                                                                <a href="/keymanagement" class="btn btn-sm btn-outline-primary">
                                                                    Kulcskezelés
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                                <div class="card-footer bg-body border-top px-4 py-3 text-muted small">
                                    A visszavétel a Kulcskezelés oldalon végezhető el. A PIN-kódos jóváhagyás továbbra is fejlesztés alatt áll.
                                    A visszavételi határidőt a foglalás vége + 15 perc alapján számoljuk.
                                    Több megfelelő foglalás esetén becsült időpont jelenik meg, amelyből nem számolunk biztos késést.
                                </div>
                            </div>

                            <div class="row g-3">
                                <!-- GYORSMŰVELETEK -->
                                <div class="col-12 col-lg-7">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-4">
                                            <h5 class="fw-bold mb-1">Gyorsműveletek</h5>
                                            <p class="text-muted small mb-4">A portaszolgálat leggyakrabban használt funkciói.</p>
                                            <div class="d-grid gap-3">
                                                <a href="/keymanagement" class="btn btn-primary btn-lg py-3 fw-semibold">
                                                    Kulcskezelés – kiadás és visszavétel
                                                </a>
                                                <a href="/issuetickets" class="btn btn-outline-secondary py-3">
                                                    Hibajegyek kezelése
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Csak az azonosítható késő kulcsok és aktív karbantartások -->
                                <div class="col-12 col-lg-5">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-4">
                                            <h5 class="fw-bold mb-1">Figyelmeztetések</h5>
                                            <p class="text-muted small mb-4">Késő kulcsok és jelenleg karbantartás alatt álló termek.</p>

                                            @if (OverdueKeyCount == 0 && ActiveMaintenanceRows.Count == 0)
                                            {
                                                <div class="alert alert-success mb-0" role="status">
                                                    Nincs aktív figyelmeztetés.
                                                </div>
                                            }
                                            else
                                            {
                                                @foreach (DashboardKeyRow lateKey in ActiveKeyRows.Where(issue => issue.IsOverdue))
                                                {
                                                    <div class="alert alert-danger mb-3" role="alert" @key="lateKey.KeyId">
                                                        <div class="fw-semibold">Késésben: @lateKey.KeyName</div>
                                                        <div class="small">Átvevő: @lateKey.ParticipantName</div>
                                                        <div class="small">Visszavételi határ: @(lateKey.DueAtLocal?.ToString("yyyy.MM.dd. HH:mm"))</div>
                                                    </div>
                                                }
                                                @foreach (DashboardMaintenanceRow maintenance in ActiveMaintenanceRows)
                                                {
                                                    <div class="alert alert-warning mb-3" role="alert" @key="maintenance.RoomId">
                                                        <div class="fw-semibold">Karbantartás alatt: @maintenance.RoomName</div>
                                                        <div class="small">@maintenance.Building / @maintenance.Floor</div>
                                                        <div class="small">Várható vég: @(maintenance.EndTime.ToString("yyyy.MM.dd. HH:mm"))</div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }


                <!-- ADMINISZTRÁTOR -->
                @if (SelectedRole == "Adminisztrátor")
                {
                    <div class="col-12">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                            <div>
                                <h4 class="fw-bold mb-1">Adminisztrátori áttekintés</h4>
                                <p class="text-muted mb-0">
                                    Termek, felszerelések és egyéb nyilvántartások aktuális állapota.
                                </p>
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                @if (LastAdminDashboardUpdate is not null)
                                {
                                    <span class="text-muted small">
                                        Frissítve: @(LastAdminDashboardUpdate.Value.ToString("yyyy.MM.dd. HH:mm:ss"))
                                    </span>
                                }
                                <button type="button" class="btn btn-outline-secondary"
                                        disabled="@IsAdminDashboardLoading" @onclick="LoadAdminDashboardAsync">
                                    @(IsAdminDashboardLoading ? "Frissítés..." : "Adatok frissítése")
                                </button>
                                <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle px-3 py-2">
                                    Adminisztrátor
                                </span>
                            </div>
                        </div>

                        @if (IsAdminDashboardLoading && LastAdminDashboardUpdate is null)
                        {
                            <div class="alert alert-info" role="status">Az admin dashboard betöltése folyamatban...</div>
                        }
                        else if (AdminDashboardError is not null)
                        {
                            <div class="alert alert-danger" role="alert">@AdminDashboardError</div>
                        }
                        else if (LastAdminDashboardUpdate is not null)
                        {
                            <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3 mb-4">
                                <div class="col">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-3 border-start border-4 border-primary rounded">
                                            <div class="text-muted small mb-2">Nyilvántartott termek</div>
                                            <div class="fs-3 fw-bold">@AdminRoomCount</div>
                                            <div class="text-muted small">@AdminBuildingRows.Count épületben</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-3 border-start border-4 border-success rounded">
                                            <div class="text-muted small mb-2">Felszerelések</div>
                                            <div class="fs-3 fw-bold">@AdminEquipmentCount</div>
                                            <div class="text-muted small">Nyilvántartott felszereléstípusok</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-3 border-start border-4 border-info rounded">
                                            <div class="text-muted small mb-2">Kulcsok</div>
                                            <div class="fs-3 fw-bold">@AdminKeyCount</div>
                                            <div class="text-muted small">Nyilvántartott fizikai kulcsok</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-3 border-start border-4 border-secondary rounded">
                                            <div class="text-muted small mb-2">Szerepkörök</div>
                                            <div class="fs-3 fw-bold">@AdminRoleCount</div>
                                            <div class="text-muted small">Egyedi rendszer-szerepkörök</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-3 border-start border-4 border-dark rounded">
                                            <div class="text-muted small mb-2">Felhasználók</div>
                                            <div class="fs-3 fw-bold">@AdminUserCount</div>
                                            <div class="text-muted small">Regisztrált felhasználói fiókok</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-3 border-start border-4 border-warning rounded">
                                            <div class="text-muted small mb-2">Aktív karbantartások</div>
                                            <div class="fs-3 fw-bold">@AdminActiveMaintenanceCount</div>
                                            <div class="text-muted small">Összesen @AdminTotalMaintenanceCount időszak</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3 mb-4">
                                <!-- admin CRUD oldalak -->
                                <div class="col-12 col-lg-7">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-4">
                                            <h5 class="fw-bold mb-1">Adminisztráció</h5>
                                            <p class="text-muted small mb-4">Nyilvántartások megtekintése és karbantartása.</p>
                                            <div class="row g-2">
                                                <div class="col-12 col-sm-6">
                                                    <a href="/rooms" class="btn btn-primary w-100">Termek kezelése</a>
                                                </div>
                                                <div class="col-12 col-sm-6">
                                                    <a href="/equipment" class="btn btn-outline-primary w-100">Felszerelések</a>
                                                </div>
                                                <div class="col-12 col-sm-6">
                                                    <a href="/keys" class="btn btn-outline-primary w-100">Kulcsok</a>
                                                </div>
                                                <div class="col-12 col-sm-6">
                                                    <a href="/roles" class="btn btn-outline-primary w-100">Szerepkörök</a>
                                                </div>
                                                <div class="col-12">
                                                    <a href="/maintenancewindows" class="btn btn-outline-secondary w-100">
                                                        Karbantartási időszakok
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Teremállomány -->
                                <div class="col-12 col-lg-5">
                                    <div class="card h-100 border-0 shadow-sm">
                                        <div class="card-body p-4">
                                            <h5 class="fw-bold mb-1">Termek épületenként</h5>
                                            <p class="text-muted small mb-3">Az adatbázisban nyilvántartott helyiségek eloszlása.</p>
                                            @if (AdminBuildingRows.Count == 0)
                                            {
                                                <div class="text-muted small">Még nincs rögzített terem.</div>
                                            }
                                            else
                                            {
                                                <div class="list-group list-group-flush">
                                                    @foreach (AdminBuildingRow building in AdminBuildingRows)
                                                    {
                                                        <div class="list-group-item px-0 d-flex justify-content-between align-items-center gap-2" @key="building.Name">
                                                            <span class="text-break">@building.Name</span>
                                                            <span class="badge bg-secondary-subtle text-secondary-emphasis">@building.RoomCount terem</span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- karbantartási adatok-->
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-body border-bottom px-4 py-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
                                    <div>
                                        <h5 class="fw-bold mb-1">Aktuális és közelgő karbantartások</h5>
                                        <p class="text-muted small mb-0">A következő legfeljebb öt érintett időszak.</p>
                                    </div>
                                    <a href="/maintenancewindows" class="btn btn-sm btn-outline-primary">Összes karbantartás</a>
                                </div>
                                <div class="card-body p-0">
                                    @if (AdminMaintenanceRows.Count == 0)
                                    {
                                        <div class="text-center text-muted py-4 px-3">
                                            Nincs aktív vagy közelgő karbantartási időszak.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-hover align-middle mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th class="ps-4">Érintett termek</th>
                                                        <th>Időszak kezdete</th>
                                                        <th>Időszak vége</th>
                                                        <th class="text-end pe-4">Állapot</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (AdminMaintenanceRow maintenance in AdminMaintenanceRows)
                                                    {
                                                        <tr @key="maintenance.Id">
                                                            <td class="ps-4">@maintenance.RoomNames</td>
                                                            <td class="text-nowrap">@(maintenance.StartTime.ToString("yyyy.MM.dd. HH:mm"))</td>
                                                            <td class="text-nowrap">@(maintenance.EndTime.ToString("yyyy.MM.dd. HH:mm"))</td>
                                                            <td class="text-end pe-4">
                                                                @if (maintenance.IsActive)
                                                                {
                                                                    <span class="badge bg-warning-subtle text-warning-emphasis">Folyamatban</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-info-subtle text-info-emphasis">Közelgő</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                @* <!-- ÜZEMELTETÉSI IGAZGATÓ --> *@
                @if (SelectedRole == "Üzemeltetési igazgató")
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body p-4">
                                <p class="text-muted small mb-4">
                                    A rendszer működésének, kihasználtságának és eseményeinek áttekintése.
                                </p>

                                <div class="d-grid gap-2">
                                    <span class="text-muted small text-center">
                                        Riportok – fejlesztés alatt
                                    </span>
                                    <span class="text-muted small text-center">
                                        Audit logok – fejlesztés alatt
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </Authorized>

    <NotAuthorized>
