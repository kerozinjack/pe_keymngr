@page "/building"
@using System.Data.Common
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Data
@using PeKeyMngr.Models
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ILogger<Building> Logger

<PageTitle>Épület áttekintése</PageTitle>

<div class="building-page">
    <header class="page-header">
        <h1>Épület áttekintése</h1>
        <p>Válasszon ki egy emeletet a helyiségek megtekintéséhez.</p>
        <button type="button" class="btn btn-outline-secondary" disabled="@IsLoading" @onclick="LoadRoomsAsync">
            Állapot frissítése
        </button>
        @if (LastUpdated is not null)
        {
            <span class="text-muted ms-2">Állapot időpontja: @LastUpdated.Value.ToString("yyyy.MM.dd. HH:mm")</span>
        }
    </header>

    @if (IsLoading)
    {
        <div class="alert alert-info" role="status">A termek betöltése folyamatban...</div>
    }
    else if (ErrorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@ErrorMessage</div>
    }
    else if (Floors.Count == 0)
    {
        <div class="alert alert-info">Az I épületben nincs megjeleníthető terem.</div>
    }
    else
    {
        <div class="building-content">
            <section class="building-section">
                <h3>I épület</h3>
                <div class="building-visual">
                    <div class="building-top"></div>
                    <div class="building-floors">
                        @foreach (FloorInfo floor in Floors.AsEnumerable().Reverse())
                        {
                            <button type="button"
                                    class="floor-button @(SelectedFloor == floor ? "selected" : "")"
                                    @onclick="() => SelectFloor(floor)">
                                <span>@floor.Floor</span>
                                <span class="floor-action">Megtekintés →</span>
                            </button>
                        }
                    </div>
                    <div class="building-side"></div>
                </div>
            </section>

            <section class="floor-section">
                @if (SelectedFloor is not null)
                {
                    <div class="floor-header">
                        <h3>@SelectedFloor.Floor</h3>
                        <p>Az emelet helyiségei</p>
                    </div>

                    <div class="room-grid">
                        @foreach (RoomInfo room in SelectedFloor.Rooms)
                        {
                            @if (room.Status == RoomStatus.Available)
                            {
                                <div class="room-box available">
                                    <span class="room-id">@room.RoomName</span>
                                    <span class="room-status">Szabad</span>
                                    <span>@room.Capacity fő</span>
                                    <span>@string.Join(", ", room.Equipment)</span>
                                </div>
                            }
                            else if (room.Status == RoomStatus.Reserved)
                            {
                                <div class="room-box reserved">
                                    <span class="room-id">@room.RoomName</span>
                                    <span class="room-status">Foglalt</span>
                                    <span>Foglalt: @(room.ReservedUntil?.ToString("yyyy.MM.dd. HH:mm"))-ig</span>
                                </div>
                            }
                            else
                            {
                                <div class="room-box maintenance">
                                    <span class="room-id">@room.RoomName</span>
                                    <span class="room-status">Karbantartás</span>
                                    <span>Karbantartás alatt van.</span>
                                </div>
                            }
                        }
                    </div>
                }
                else
                {
                    <div class="empty-selection">Válasszon ki egy szintet az épületből!</div>
                }
            </section>
        </div>

        <div class="status-legend">
            <span><i class="status-dot available"></i> Szabad</span>
            <span><i class="status-dot reserved"></i> Foglalt</span>
            <span><i class="status-dot maintenance"></i> Karbantartás</span>
        </div>
    }
</div>

@code {
    private List<FloorInfo> Floors = [];
    private FloorInfo? SelectedFloor;
    private bool IsLoading;
    private string? ErrorMessage;
    private DateTime? LastUpdated;

    protected override Task OnInitializedAsync() => LoadRoomsAsync();

    private async Task LoadRoomsAsync()
    {
        if (IsLoading)
        {
            return;
        }

        IsLoading = true;
        ErrorMessage = null;
        try
        {
            DateTime now = DateTime.Now;
            await using ApplicationDbContext context = await DbFactory.CreateDbContextAsync();
            List<Room> rooms = await context.Rooms
                .AsNoTracking()
                .Include(room => room.Equipments)
                .Where(room => room.Building == "I")
                .OrderBy(room => room.Floor)
                .ThenBy(room => room.RoomName)
                .ToListAsync();

            var reservations = await context.Reservations
                .AsNoTracking()
                .Where(reservation =>
                    !reservation.IsNoShow &&
                    reservation.Room.Building == "I" &&
                    reservation.StartTime <= now &&
                    reservation.EndTime > now)
                .Select(reservation => new
                {
                    reservation.Room.RoomId,
                    reservation.EndTime
                })
                .ToListAsync();

            List<MaintenanceWindow> maintenanceWindows = await context.MaintenanceWindows
                .AsNoTracking()
                .Include(window => window.AffectedRooms)
                .Where(window =>
                    window.StartTime <= now &&
                    window.EndTime > now &&
                    window.AffectedRooms.Any(room => room.Building == "I"))
                .ToListAsync();
            HashSet<Guid> maintenanceRoomIds = maintenanceWindows
                .SelectMany(window => window.AffectedRooms.Select(room => room.RoomId))
                .ToHashSet();
            Dictionary<Guid, DateTime> reservedRooms = reservations
                .GroupBy(reservation => reservation.RoomId)
                .ToDictionary(group => group.Key, group => group.Max(reservation => reservation.EndTime));

            List<FloorInfo> floors = rooms
                .GroupBy(room => room.Floor)
                .Select(group => new FloorInfo(
                    group.Key,
                    group.Select(room =>
                    {
                        bool isReserved = reservedRooms.TryGetValue(room.RoomId, out DateTime reservedUntil);
                        RoomStatus status = maintenanceRoomIds.Contains(room.RoomId)
                            ? RoomStatus.Maintenance
                            : isReserved ? RoomStatus.Reserved : RoomStatus.Available;
                        return new RoomInfo(
                            room.RoomName,
                            room.Capacity,
                            room.Equipments.Select(equipment => equipment.EquipmentName).ToList(),
                            status,
                            isReserved ? reservedUntil : null);
                    }).ToList()))
                .ToList();

            SelectedFloor = SelectedFloor is FloorInfo selectedFloor
                ? floors.FirstOrDefault(floor =>
                    floor.Floor == selectedFloor.Floor)
                : null;
            Floors = floors;
            LastUpdated = now;
        }
        catch (DbException exception)
        {
            Logger.LogError(exception, "Failed to load building room availability");
            ErrorMessage = "Nem sikerült betölteni a termek állapotát. Próbálja újra a frissítést.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void SelectFloor(FloorInfo floor) => SelectedFloor = floor;

    private sealed record FloorInfo(string Floor, List<RoomInfo> Rooms);

    private sealed record RoomInfo(
        string RoomName,
        int Capacity,
        List<string> Equipment,
        RoomStatus Status,
        DateTime? ReservedUntil);

    private enum RoomStatus
    {
        Available,
        Reserved,
        Maintenance
    }
}
