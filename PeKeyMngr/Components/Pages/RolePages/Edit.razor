@page "/roles/edit"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Models
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@attribute [Authorize(Policy = "CanAccessAdminPages")]

<PageTitle>Szerepkör szerkesztése</PageTitle>

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3 mb-1">Szerepkör szerkesztése</h1>
        <p class="text-muted mb-0">Módosítsd a kiválasztott szerepkör nevét.</p>
    </div>

    @if (Role is null)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <div class="spinner-border text-primary mb-3" role="status">
                    <span class="visually-hidden">Betöltés...</span>
                </div>
                <p class="text-muted mb-0">A szerepkör adatainak betöltése...</p>
            </div>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8 col-xl-7">
                <div class="card shadow-sm">
                    <div class="card-header bg-light py-3">
                        <h2 class="h5 mb-0">Szerepkör adatai</h2>
                    </div>

                    <div class="card-body p-4">
                        <EditForm method="post" Model="Role" OnValidSubmit="UpdateRole" FormName="edit" Enhance>
                            <DataAnnotationsValidator />

                            <input type="hidden" name="Role.RoleId" value="@Role.RoleId" />

                            <div class="mb-4">
                                <label for="rolename" class="form-label fw-semibold">Szerepkör neve</label>
                                <InputText id="rolename" @bind-Value="Role.RoleName" class="form-control" />
                                <ValidationMessage For="() => Role.RoleName" class="text-danger small" />
                            </div>

                            <ValidationSummary class="text-danger mb-3" role="alert" />

                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-3 border-top">
                                <a href="/roles" class="btn btn-outline-secondary">
                                    Vissza a szerepkörökhöz
                                </a>

                                <button type="submit" class="btn btn-primary px-4">
                                    Módosítások mentése
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    private Guid RoleId { get; set; }

    [SupplyParameterFromForm]
    private Role? Role { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Role ??= await context.CustomRoles.FirstOrDefaultAsync(m => m.RoleId == RoleId);

        if (Role is null)
        {
            NavigationManager.NotFound();
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateRole()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Role!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!RoleExists(Role!.RoleId))
            {
                NavigationManager.NotFound();
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/roles");
    }

    private bool RoleExists(Guid roleid)
    {
        using var context = DbFactory.CreateDbContext();
        return context.CustomRoles.Any(e => e.RoleId == roleid);
    }
}