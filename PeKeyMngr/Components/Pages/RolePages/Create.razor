@page "/roles/create"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Models
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@attribute [Authorize(Policy = "CanAccessAdminPages")]

<PageTitle>Új szerepkör létrehozása</PageTitle>

<div class="container py-4">
    <div class="mb-4">
        <h3 class="mb-1">Új szerepkör létrehozása</h3>
        <p class="text-muted mb-0">
            Új szerepkör hozzáadása a rendszerhez.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">
            <div class="card shadow-sm">
                <div class="card-header bg-light py-3">
                    <h5 class="mb-0">Szerepkör adatai</h5>
                </div>

                <EditForm method="post" Model="Role" OnValidSubmit="AddRole" FormName="create" Enhance>
                    <DataAnnotationsValidator />

                    <div class="card-body p-4">
                        <ValidationSummary class="text-danger mb-3" role="alert" />

                        <div class="mb-3">
                            <label for="rolename" class="form-label">Szerepkör neve</label>
                            <InputText id="rolename"
                                       @bind-Value="Role.RoleName"
                                       class="form-control"
                                       placeholder="Add meg a szerepkör nevét..." />
                            <ValidationMessage For="() => Role.RoleName" class="text-danger" />
                        </div>
                    </div>

                    <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                        <a href="/roles" class="btn btn-outline-secondary">
                            Vissza a listához
                        </a>

                        <button type="submit" class="btn btn-primary">
                            Szerepkör létrehozása
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private Role Role { get; set; } = default!;

    protected override void OnInitialized() => Role ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddRole()
    {
        using var context = DbFactory.CreateDbContext();
        context.CustomRoles.Add(Role);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/roles");
    }
}