@page "/roles/delete"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Models
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@attribute [Authorize(Policy = "CanAccessAdminPages")]

<PageTitle>Szerepkör törlése</PageTitle>

<div class="container py-4">
    <div class="mb-4">
        <h3 class="mb-1">Szerepkör törlése</h3>
        <p class="text-muted mb-0">
            A kiválasztott szerepkör eltávolítása a rendszerből.
        </p>
    </div>

    @if (role is null)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <div class="spinner-border text-primary mb-3" role="status">
                    <span class="visually-hidden">Betöltés...</span>
                </div>
                <p class="text-muted mb-0">A szerepkör adatainak betöltése...</p>
            </div>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8 col-xl-7">
                <div class="card shadow-sm">
                    <div class="card-header bg-light py-3">
                        <h5 class="mb-0">Törlendő szerepkör adatai</h5>
                    </div>

                    <div class="card-body p-4">
                        <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                            <div>
                                <strong>Figyelem!</strong>
                                Biztosan törölni szeretné ezt a szerepkört? A művelet nem vonható vissza.
                            </div>
                        </div>

                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">Szerepkör neve</dt>
                            <dd class="col-sm-8 fw-semibold">@role.RoleName</dd>
                        </dl>
                    </div>

                    <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                        <a href="/roles" class="btn btn-outline-secondary">
                            Mégse
                        </a>

                        <EditForm method="post" Model="role" OnValidSubmit="DeleteRole" FormName="delete" Enhance>
                            <button type="submit" class="btn btn-danger" disabled="@(role is null)">
                                Szerepkör törlése
                            </button>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private Role? role;

    [SupplyParameterFromQuery]
    private Guid RoleId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        role = await context.CustomRoles.FirstOrDefaultAsync(m => m.RoleId == RoleId);

        if (role is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteRole()
    {
        using var context = DbFactory.CreateDbContext();
        context.CustomRoles.Remove(role!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/roles");
    }
}