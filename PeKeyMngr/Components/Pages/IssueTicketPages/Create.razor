@page "/issuetickets/create"
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Data
@using PeKeyMngr.Data.DTO
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@using PeKeyMngr.Models

@attribute [Authorize]

<PageTitle>Hibajegy létrehozása</PageTitle>

<AuthorizeView Context="authContext">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-7 col-xl-6">
                <div class="mb-4">
                    <h3 class="mb-1">Új hibajegy létrehozása</h3>
                    <p class="text-muted mb-0">
                        Új hibabejelentés rögzítése a nyilvántartásban.
                    </p>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header bg-light py-3">
                        <h5 class="mb-0">Hibajegy adatai</h5>
                    </div>

                    <div class="card-body">
                        <EditForm method="post" Model="IssueTicket" OnValidSubmit="AddIssueTicket" FormName="create" Enhance>
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger" role="alert" />

                            <div class="mb-3">
                                <label for="timestamp" class="form-label">Bejelentés időpontja</label>
                                <InputDate id="timestamp" @bind-Value="IssueTicket.Timestamp" class="form-control" />
                                <ValidationMessage For="() => IssueTicket.Timestamp" class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label for="issuedescription" class="form-label">Hiba leírása</label>
                                <InputText id="issuedescription" @bind-Value="IssueTicket.IssueDescription" class="form-control" />
                                <ValidationMessage For="() => IssueTicket.IssueDescription" class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label for="affectedroom" class="form-label">Érintett terem</label>
                                <InputSelect id="affectedroom" @bind-Value="IssueTicket.AffectedRoom" class="form-control">
                                    @foreach (KeyValuePair<string, string> kvp in Rooms)
                                    {
                                        <option value="@kvp.Key">@kvp.Value</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => IssueTicket.AffectedRoom" class="text-danger" />
                            </div>

                            <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mt-4">
                                <a href="/issuetickets" class="btn btn-outline-secondary">
                                    Vissza
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    Hibajegy létrehozása
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    </div>
</AuthorizeView>

@code {
    [SupplyParameterFromForm]
    private IssueTicketDto IssueTicket { get; set; } = default!;
    private Dictionary<string, string> Rooms{get; set;} = default!;

    protected override void OnInitialized()
    {
        using var context = DbFactory.CreateDbContext();
        IssueTicket ??= new(){};
        Rooms = context.Rooms.ToDictionary(r => r.RoomId.ToString(), r => r.RoomName);
    }

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddIssueTicket()
    {
        using var context = DbFactory.CreateDbContext();
        AuthenticationState authState = await AuthStateProvider.GetAuthenticationStateAsync();
        ClaimsPrincipal principal = authState.User;
        ApplicationUser? user = await UserManager.GetUserAsync(principal);

        if (user == null)
        {
            Console.WriteLine("User not found");
            NavigationManager.NavigateTo("/Error");
            return;
        }

        context.Attach(user);
        IssueTicket? ticket = IssueTicket.ToIssueTicket(user, context);
        if (ticket == null)
        {
            Console.WriteLine("Ticket null");
            NavigationManager.NavigateTo("/Error");
            return;
        }
        
        context.IssueTickets.Add(ticket);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/issuetickets");
    }
}