@page "/issuetickets/details"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Models
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@attribute [Authorize]

<PageTitle>Hibajegy részletei</PageTitle>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">
            <div class="mb-4">
                <h3 class="mb-1">Hibajegy részletei</h3>
                <p class="text-muted mb-0">
                    A kiválasztott hibabejelentés részletes adatai.
                </p>
            </div>

            @if (issueticket is null)
            {
                <div class="card shadow-sm">
                    <div class="card-body text-center py-4">
                        <div class="spinner-border text-primary mb-3" role="status">
                            <span class="visually-hidden">Betöltés...</span>
                        </div>
                        <p class="text-muted mb-0">Hibajegy betöltése...</p>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-light py-3">
                        <h5 class="mb-0">Hibajegy információi</h5>
                    </div>

                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted mb-2">Bejelentés időpontja</dt>
                            <dd class="col-sm-8 mb-3">@issueticket.Timestamp</dd>

                            <dt class="col-sm-4 text-muted mb-2">Hiba leírása</dt>
                            <dd class="col-sm-8 mb-3">@issueticket.IssueDescription</dd>

                            <dt class="col-sm-4 text-muted mb-2">Érintett terem</dt>
                            <dd class="col-sm-8 mb-3">@issueticket.AffectedRoom.RoomName</dd>

                            <dt class="col-sm-4 text-muted mb-2">Bejelentő</dt>
                            <dd class="col-sm-8 mb-0">@issueticket.ReportedBy.UserName</dd>
                        </dl>
                    </div>

                    <div class="card-footer bg-white d-flex flex-column flex-sm-row justify-content-end gap-2 py-3">
                        <a href="/issuetickets" class="btn btn-outline-secondary">
                            Vissza a listához
                        </a>
                        <a href="@($"/issuetickets/edit?ticketid={issueticket.TicketId}")"
                           class="btn btn-primary">
                            Szerkesztés
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private IssueTicket? issueticket;

    [SupplyParameterFromQuery]
    private Guid TicketId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        issueticket = await context.IssueTickets.Include(ticket => ticket.AffectedRoom).Include(ticket => ticket.ReportedBy).FirstOrDefaultAsync(m => m.TicketId == TicketId);

        if (issueticket is null)
        {
            NavigationManager.NotFound();
        }
    }
}