@page "/issuetickets/delete"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Models
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@attribute [Authorize(Policy = "CanAccessAdminPages")]

<PageTitle>Hibajegy törlése</PageTitle>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-7 col-xl-6">
            <div class="mb-4">
                <h3 class="mb-1">Hibajegy törlése</h3>
                <p class="text-muted mb-0">
                    A kiválasztott hibajegy eltávolítása a nyilvántartásból.
                </p>
            </div>

            @if (issueticket is null)
            {
                <div class="card shadow-sm">
                    <div class="card-body text-center py-4">
                        <div class="spinner-border text-primary mb-3" role="status">
                            <span class="visually-hidden">Betöltés...</span>
                        </div>
                        <p class="text-muted mb-0">Hibajegy betöltése...</p>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-light py-3">
                        <h5 class="mb-0">Törlendő hibajegy adatai</h5>
                    </div>

                    <div class="card-body">
                        <div class="alert alert-warning" role="alert">
                            Biztosan törölni szeretné ezt a hibajegyet? A művelet nem vonható vissza.
                        </div>

                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted mb-2">Bejelentés időpontja</dt>
                            <dd class="col-sm-8 mb-3">@issueticket.Timestamp</dd>

                            <dt class="col-sm-4 text-muted mb-2">Hiba leírása</dt>
                            <dd class="col-sm-8 mb-0">@issueticket.IssueDescription</dd>
                        </dl>
                    </div>

                    <div class="card-footer bg-white py-3">
                        <EditForm method="post" Model="issueticket" OnValidSubmit="DeleteIssueTicket" FormName="delete">
                            <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                                <a href="/issuetickets" class="btn btn-outline-secondary">
                                    Mégse
                                </a>
                                <button type="submit" class="btn btn-danger" disabled="@(issueticket is null)">
                                    Hibajegy törlése
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private IssueTicket? issueticket;

    [SupplyParameterFromQuery]
    private Guid TicketId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        issueticket = await context.IssueTickets.FirstOrDefaultAsync(m => m.TicketId == TicketId);

        if (issueticket is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteIssueTicket()
    {
        using var context = DbFactory.CreateDbContext();
        context.IssueTickets.Remove(issueticket!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/issuetickets");
    }
}