@page "/issuetickets/edit"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Data.DTO
@using PeKeyMngr.Models
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@attribute [Authorize]

<PageTitle>Hibajegy szerkesztése</PageTitle>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-7 col-xl-6">
            <div class="mb-4">
                <h3 class="mb-1">Hibajegy szerkesztése</h3>
                <p class="text-muted mb-0">
                    A hibabejelentés adatainak módosítása.
                </p>
            </div>

            @if (IssueTicket is null)
            {
                <div class="card shadow-sm">
                    <div class="card-body text-center py-4">
                        <div class="spinner-border text-primary mb-3" role="status">
                            <span class="visually-hidden">Betöltés...</span>
                        </div>
                        <p class="text-muted mb-0">Hibajegy betöltése...</p>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-light py-3">
                        <h5 class="mb-0">Hibajegy adatai</h5>
                    </div>

                    <div class="card-body">
                        <EditForm method="post" Model="IssueTicket" OnValidSubmit="UpdateIssueTicket" FormName="edit" Enhance>
                            <DataAnnotationsValidator />
                            <ValidationSummary role="alert" />

                            <input type="hidden" name="IssueTicket.TicketId" value="@IssueTicket.TicketId" />

                            <div class="mb-3">
                                <label for="timestamp" class="form-label">Bejelentés időpontja</label>
                                <InputDate id="timestamp" @bind-Value="IssueTicket.Timestamp" class="form-control" />
                                <ValidationMessage For="() => IssueTicket.Timestamp" class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label for="issuedescription" class="form-label">Hiba leírása</label>
                                <InputText id="issuedescription" @bind-Value="IssueTicket.IssueDescription" class="form-control" />
                                <ValidationMessage For="() => IssueTicket.IssueDescription" class="text-danger" />
                            </div>

                            <div class="mb-3">
                                <label for="affectedroom" class="form-label">Érintett terem</label>
                                <InputSelect id="affectedroom" @bind-Value="IssueTicket.AffectedRoom" class="form-control">
                                    @foreach (KeyValuePair<string, string> kvp in Rooms)
                                    {
                                        if (OriginalIssueTicket != null)
                                        {
                                            if(kvp.Key == OriginalIssueTicket.AffectedRoom.RoomId.ToString())
                                            {
                                                <option value="@kvp.Key" selected>@kvp.Value</option>
                                            }
                                            else
                                            {
                                                <option value="@kvp.Key">@kvp.Value</option>
                                            }
                                        }
                                        else
                                        {
                                            <option value="@kvp.Key">@kvp.Value</option>
                                        }
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => IssueTicket.AffectedRoom" class="text-danger" />
                            </div>

                            <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mt-4">
                                <a href="/issuetickets" class="btn btn-outline-secondary">
                                    Vissza
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    Módosítások mentése
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private Guid TicketId { get; set; }

    private Dictionary<string, string> Rooms { get; set; } = new();
    private IssueTicket? OriginalIssueTicket { get; set; }

    [SupplyParameterFromForm]
    private IssueTicketDto? IssueTicket { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        if (IssueTicket == null)
        {
            IssueTicket = new();
            IssueTicket?.FromIssueTicket(await context.IssueTickets.Include(ticket => ticket.AffectedRoom).FirstOrDefaultAsync(m => m.TicketId == TicketId));
        }
        
        OriginalIssueTicket ??= await context.IssueTickets.Include(ticket => ticket.AffectedRoom).FirstOrDefaultAsync(m => m.TicketId == TicketId);
        Rooms = context.Rooms.ToDictionary(k => k.RoomId.ToString(), v => v.RoomName);

        if (IssueTicket is null)
        {
            NavigationManager.NotFound();
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateIssueTicket()
    {
        using var context = DbFactory.CreateDbContext();
        if (OriginalIssueTicket is null || IssueTicket is null)
        {
            return;
        }
        Room? AffRoom = context.Rooms.FirstOrDefault(r => r.RoomId.ToString() == IssueTicket.AffectedRoom);
        if (AffRoom != null)
        {
            OriginalIssueTicket.AffectedRoom = AffRoom;
        }
        OriginalIssueTicket.Timestamp = IssueTicket.Timestamp;
        OriginalIssueTicket.IssueDescription = IssueTicket.IssueDescription;
        context.Attach(OriginalIssueTicket!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!IssueTicketExists(OriginalIssueTicket.TicketId))
            {
                NavigationManager.NotFound();
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/issuetickets");
    }

    private bool IssueTicketExists(Guid ticketid)
    {
        using var context = DbFactory.CreateDbContext();
        return context.IssueTickets.Any(e => e.TicketId == ticketid);
    }
}