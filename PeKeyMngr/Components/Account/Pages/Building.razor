@page "/building"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Épület áttekintése</PageTitle>

<div class="building-page">

    <header class="page-header">
        <h1>Épület áttekintése</h1>
        <p>Válassz ki egy emeletet a helyiségek megtekintéséhez.</p>
        <div class="room-search-controls">
            <div class="room-search-field">
                <label for="room-search">Terem keresése</label>
                <input id="room-search"
                       type="search"
                       placeholder="Teremszám, név vagy felszerelés"
                       @bind="SearchTerm"
                       @bind:event="oninput" />
            </div>
            <button type="button"
                    class="availability-filter @(AvailableOnly ? "active" : "")"
                    aria-pressed="@AvailableOnly"
                    @onclick="ToggleAvailableOnly">
                Csak szabad termek
            </button>
        </div>
    </header>

    <div class="building-content">
        <section class="building-section">
            <h3>Épület</h3>

            <div class="building-visual">
                <div class="building-top"></div>
                <div class="building-floors">

                    @foreach (var floor in Floors.AsEnumerable().Reverse())
                    {
                        <button type="button"
                                class="floor-button @(SelectedFloor == floor ? "selected" : "")"
                                @onclick="() => SelectFloor(floor)">

                            <span>@floor.Name</span>
                            <span class="floor-action">Megtekintés →</span>

                        </button>
                    }

                </div>

                <div class="building-side"></div>
            </div>
        </section>

        <section class="floor-section">

            @if (SelectedFloor is not null || HasActiveRoomFilter)
            {
                var rooms = GetVisibleRooms();
                <div class="floor-header">
                    <h3>@(HasActiveRoomFilter ? "Keresési eredmények" : SelectedFloor!.Name)</h3>
                    <p>@(HasActiveRoomFilter ? $"{rooms.Count} találat az összes emeleten" : "Az emelet helyiségei")</p>
                </div>

                @if (rooms.Count > 0)
                {
                    <div class="room-grid">
                        @foreach (var room in rooms)
                        {
                            @if (room.Status == "Available")
                            {
                                <!-- SZABAD TEREM: KATTINTHATÓ -->
                                <button type="button"
                                        class="room-box available"
                                        @onclick="() => OpenRoom(room)">

                                    <span class="room-id">@room.FullName</span>

                                    <span class="room-status">
                                        Szabad
                                    </span>

                                    <span>@room.Name</span>
                                    <span>@room.Capacity fő</span>

                                    <span>
                                        @string.Join(", ", room.Equipment)
                                    </span>

                                </button>
                            }
                            else if (room.Status == "Reserved")
                            {
                                <!-- FOGLALT TEREM: NEM KATTINTHATÓ -->
                                <div class="room-box reserved">

                                    <span class="room-id">@room.FullName</span>

                                    <span class="room-status">
                                        Foglalt
                                    </span>

                                    <span>
                                        Foglalt: @room.ReservedBy által,
                                        @room.ReservedUntil-ig
                                    </span>

                                </div>
                            }
                            else if (room.Status == "Maintenance")
                            {
                                <!-- KARBANTARTÁS: NEM KATTINTHATÓ -->
                                <div class="room-box maintenance">

                                    <span class="room-id">@room.FullName</span>

                                    <span class="room-status">
                                        Karbantartás
                                    </span>

                                    <span>
                                        Karbantartás alatt van.
                                    </span>

                                </div>
                            }
                        }
                    </div>
                }
                else
                {
                    <div class="empty-selection">
                        Nincs a keresési feltételeknek megfelelő terem.
                    </div>
                }
            }
            else
            {
                <div class="empty-selection">
                    Válassz ki egy szintet az épületből!
                </div>
            }

        </section>

    </div>
    <div class="status-legend">
        <span><i class="status-dot available"></i> Szabad</span>
        <span><i class="status-dot reserved"></i> Foglalt</span>
        <span><i class="status-dot maintenance"></i> Karbantartás</span>
    </div>

</div>

@code {
    private List<FloorInfo> Floors = new();

    private FloorInfo? SelectedFloor = null;
    private string SearchTerm = "";
    private bool AvailableOnly;

    private bool HasActiveRoomFilter =>
        !string.IsNullOrWhiteSpace(SearchTerm) || AvailableOnly;

    protected override async Task OnInitializedAsync()
    {

        if (!Floors.Any())
        {
            LoadMockData(); // Ideiglenes tesztadatok betöltése
        }

        await Task.CompletedTask;
    }

    // Kiválasztott szint beállítása.
    private void SelectFloor(FloorInfo floor)
    {
        SelectedFloor = floor;
        SearchTerm = "";
    }

    private void ToggleAvailableOnly()
    {
        AvailableOnly = !AvailableOnly;
    }

    private List<RoomInfo> GetVisibleRooms()
    {
        IEnumerable<RoomInfo> rooms = HasActiveRoomFilter
            ? Floors.SelectMany(floor => floor.Rooms)
            : SelectedFloor is null
                ? Enumerable.Empty<RoomInfo>()
                : SelectedFloor.Rooms;

        if (AvailableOnly)
        {
            rooms = rooms.Where(room => room.Status == "Available");
        }

        if (!string.IsNullOrWhiteSpace(SearchTerm))
        {
            var searchTerm = SearchTerm.Trim();
            rooms = rooms.Where(room =>
                room.FullName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                room.RoomName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                room.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                room.Equipment.Any(equipment =>
                    equipment.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));
        }

        return rooms.ToList();
    }

    // Szabad terem esetén átirányítás a foglalási oldalra.
    private void OpenRoom(RoomInfo room)
    {
        if (room.Status != "Available")
            return;

        Navigation.NavigateTo(
            $"/foglalas?room={Uri.EscapeDataString(room.FullName)}"
        );
    }

