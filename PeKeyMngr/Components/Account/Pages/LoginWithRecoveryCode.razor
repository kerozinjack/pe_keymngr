﻿@page "/Account/LoginWithRecoveryCode"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using PeKeyMngr.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<LoginWithRecoveryCode> Logger
@inject AuditLogWriter AuditWriter

<PageTitle>Helyreállítási kód ellenőrzése</PageTitle>

<h1>Helyreállítási kód ellenőrzése</h1>
<hr />
<StatusMessage Message="@message" />
<p>
    Helyreállítási kóddal szeretnél bejelentkezni. A bejelentkezésedet a rendszer nem jegyzi meg mindaddig, amíg
    bejelentkezéskor meg nem adod a hitelesítő alkalmazás által generált kódot, vagy ki nem kapcsolod a kétlépcsős hitelesítést,
    majd újra be nem jelentkezel.
</p>
<div class="row">
    <div class="col-md-4">
        <EditForm Model="Input" FormName="login-with-recovery-code" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.RecoveryCode" id="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="Helyreállítási kód" />
                <label for="Input.RecoveryCode" class="form-label">Helyreállítási kód</label>
                <ValidationMessage For="() => Input.RecoveryCode" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Bejelentkezés</button>
        </EditForm>
    </div>
</div>

@code {
    private string? message;
    private ApplicationUser user = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        // Ellenőrizzük, hogy a felhasználó először megadta-e a felhasználónevét és a jelszavát.
        user = await SignInManager.GetTwoFactorAuthenticationUserAsync() ??
            throw new InvalidOperationException("Nem sikerült betölteni a kétlépcsős hitelesítéshez tartozó felhasználót.");
    }

    // A normál Login-oldal a 2FA szükségességekor ide irányít.
    // A sikeres belépést CSAK a tényleges 2FA/Recovery siker után írjuk be.
    private async Task OnValidSubmitAsync()
    {
        var recoveryCode = Input.RecoveryCode.Replace(" ", string.Empty);

        var result = await SignInManager.TwoFactorRecoveryCodeSignInAsync(recoveryCode);

        var userId = await UserManager.GetUserIdAsync(user);

        // Az Identity által visszaadott eredmény alapján készítünk eseménylogot.
        if (result.Succeeded)
        {
            await AuditWriter.WriteAsync("Hitelesítés", $"Felhasználó: {user.UserName ?? userId} helyreállító kóddal bejelentkezett.");
            Logger.LogInformation("A(z) '{UserId}' azonosítójú felhasználó helyreállítási kóddal bejelentkezett.", userId);
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.IsLockedOut)
        {
            await AuditWriter.WriteAsync(
                "Hitelesítés", $"Sikertelen helyreállító kód (zárolt fiók): {user.UserName ?? userId}.",
                PeKeyMngr.Models.Severity.Warn);
            Logger.LogWarning("A felhasználói fiókot zárolták.");
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            await AuditWriter.WriteAsync(
                "Hitelesítés", $"Sikertelen helyreállító kód: {user.UserName ?? userId}.",
                PeKeyMngr.Models.Severity.Warn);
            Logger.LogWarning("Érvénytelen helyreállítási kódot adtak meg a(z) '{UserId}' azonosítójú felhasználóhoz.", userId);
            message = "Hiba: Érvénytelen helyreállítási kód.";
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "A(z) {0} megadása kötelező.")]
        [DataType(DataType.Text)]
        [Display(Name = "Helyreállítási kód")]
        public string RecoveryCode { get; set; } = "";
    }
}
