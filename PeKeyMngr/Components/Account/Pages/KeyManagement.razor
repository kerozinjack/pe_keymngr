    *@

    <div class="small text-muted mb-3">
        <!-- tesztórához @TestClock.Now.Tostring("yyyy.MM.dd.")-->
        Foglalások napja: <strong>@DateTime.Today.ToString("yyyy.MM.dd.")</strong> 
        <span class="ms-2">(csak ennek a napnak a foglalásai)</span>
    </div>
    @if (isLoading)
    {
        <div class="alert alert-info">Adatok betöltése...</div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div role="alert" class="alert @(lastSuccess ? "alert-success" : "alert-danger")">
                @message
            </div>
        }

        <!-- Áttekintés: valódi foglalások és kulcstranzakciók -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-xl-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body border-start border-4 border-primary rounded p-3">
                        <div class="text-muted small mb-1">Mai foglalások</div>
                        <div class="fs-3 fw-bold">@todaysReservations.Count</div>
                        <div class="text-muted small">@roomCards.Count érintett teremben</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body border-start border-4 border-success rounded p-3">
                        <div class="text-muted small mb-1">Szabad kulcsok</div>
                        <div class="fs-3 fw-bold">@AvailableKeyCount</div>
                        <div class="text-muted small">A mai foglalások termeit nyitó fizikai kulcsok</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body border-start border-4 border-warning rounded p-3">
                        <div class="text-muted small mb-1">Jelenleg kiadott kulcsok</div>
                        <div class="fs-3 fw-bold">@activeIssues.Count</div>
                        <div class="text-muted small">Adatbázis alapján</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-xl-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body border-start border-4 border-secondary rounded p-3">
                        <div class="text-muted small mb-1">Épületek mai foglalással</div>
                        <div class="fs-3 fw-bold">@BuildingOptions.Count</div>
                        <div class="text-muted small">Elérhető szűrők</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 align-items-start">
            <!-- Keresés és teremválasztás -->
            <div class="col-12 col-xl-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-3 p-lg-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                            <div>
                                <h5 class="fw-bold mb-1">Terem kiválasztása</h5>
                                <p class="text-muted small mb-0">Keress teremre, épületre, oktatóra vagy kulcsra a mai foglalásokban.</p>
                            </div>
                            <span class="badge bg-primary-subtle text-primary-emphasis">
                                @FilteredRooms.Count találat
                            </span>
                        </div>

                        @if (roomCards.Count == 0)
                        {
                            <div class="alert alert-info mb-0">
                                Ma nincs rögzített teremfoglalás. A foglalások létrehozása után itt jelennek meg az oktatók és a hozzájuk rendelhető kulcsok.
                            </div>
                        }
                        else
                        {
                            <div class="row g-3 mb-3">
                                <div class="col-12 col-md-7">
                                    <label for="room-search" class="form-label small fw-semibold">Keresés</label>
                                    <input id="room-search" type="search" class="form-control"
                                           value="@searchText" @oninput="OnSearchChanged"
                                           placeholder="Pl. I/102, kulcsnév, oktató..." disabled="@isBusy" />
                                </div>
                                <div class="col-12 col-md-5">
                                    <label for="building-filter" class="form-label small fw-semibold">Épület</label>
                                    <select id="building-filter" class="form-select" value="@selectedBuilding"
                                            @onchange="OnBuildingChanged" disabled="@isBusy">
                                        <option value="">Összes épület</option>
                                        @foreach (string building in BuildingOptions)
                                        {
                                            <option value="@building">@building</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="small fw-semibold mb-2">Szint</div>
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="button" class="btn btn-sm @(selectedFloor.Length == 0 ? "btn-primary" : "btn-outline-secondary")"
                                            disabled="@isBusy" @onclick="() => SelectFloor(string.Empty)">
                                        Összes szint
                                    </button>
                                    @foreach (string floor in FloorOptions)
                                    {
                                        <button type="button" class="btn btn-sm @(selectedFloor == floor ? "btn-primary" : "btn-outline-secondary")"
                                                disabled="@isBusy" @onclick="() => SelectFloor(floor)">
                                            @floor
                                        </button>
                                    }
                                </div>
                            </div>

                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                                <div class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" id="only-available"
                                           checked="@onlyAvailable" @onchange="OnOnlyAvailableChanged" disabled="@isBusy" />
                                    <label class="form-check-label small" for="only-available">Csak szabad kulccsal rendelkező termek</label>
                                </div>
                                <div class="small text-muted">A teremszín a kulcsok elérhetőségét, nem a terem használatát jelzi.</div>
                            </div>

                            @if (FilteredRooms.Count == 0)
                            {
                                <div class="alert alert-light border text-muted mb-0">
                                    Nincs találat a megadott szűrőkkel. Próbálj másik keresést vagy szintet!
                                </div>
                            }
                            else
                            {
                                <div class="row g-3">
                                    @foreach (RoomOption room in PagedRooms)
                                    {
                                        <div class="col-12 col-md-6 col-xxl-4" @key="room.RoomId">
                                            <button type="button"
                                                    class="card w-100 h-100 text-start shadow-sm p-3 @(selectedRoomId == room.RoomId ? "border-primary border-2" : "border-light")"
                                                    aria-pressed="@(selectedRoomId == room.RoomId)"
                                                    disabled="@isBusy"
                                                    @onclick="() => SelectRoom(room.RoomId)">
                                                <div class="d-flex align-items-start justify-content-between gap-2 mb-3">
                                                    <div class="fw-bold fs-5 text-dark text-break">@room.DisplayName</div>
                                                    <span class="badge @(GetRoomStatusBadgeClass(GetRoomKeyStatus(room))) text-nowrap">
                                                        @GetRoomStatusLabel(GetRoomKeyStatus(room))
                                                    </span>
                                                </div>
                                                <div class="text-muted small text-break">@room.Building</div>
                                                <div class="text-muted small mb-3">@room.Floor</div>
                                                <div class="mt-auto d-flex justify-content-between align-items-center gap-2 border-top pt-2 small">
                                                    <span class="text-secondary">@room.Reservations.Count foglalás • @AvailableKeysForRoom(room) szabad / @room.KeyIds.Count összes kulcs</span>
                                                    <span class="@(selectedRoomId == room.RoomId ? "text-primary" : "text-muted") fw-semibold">
                                                        @(selectedRoomId == room.RoomId ? "Kiválasztva" : "Részletek")
                                                    </span>
                                                </div>
                                            </button>
                                        </div>
                                    }
                                </div>

                                @if (PageCount > 1)
                                {
                                    <div class="d-flex justify-content-between align-items-center gap-2 mt-4">
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                disabled="@(isBusy || currentPage <= 1)" @onclick="PreviousPage">
                                            Előző
                                        </button>
                                        <span class="small text-muted">@currentPage / @PageCount. oldal</span>
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                disabled="@(isBusy || currentPage >= PageCount)" @onclick="NextPage">
                                            Következő
                                        </button>
                                    </div>
                                }
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Foglalás → Kulcs: a portás valódi foglaláshoz ad ki kulcsot. -->
            <div class="col-12 col-xl-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-3 p-lg-4">
                        <h5 class="fw-bold mb-1">Kulcskiadás</h5>
                        <p class="text-muted small mb-4">
                            Válassz termet, azon belül valódi foglalást, majd a hozzá tartozó kulcsot.
                        </p>

                        @if (SelectedRoom is null)
                        {
                            <div class="text-center rounded-3 bg-light border p-4">
                                <div class="fs-2 mb-2">🔑</div>
                                <div class="fw-semibold">Még nincs kiválasztott terem</div>
                                <div class="text-muted small mt-1">Válassz egyet a bal oldali kártyák közül!</div>
                            </div>
                        }
                        else
                        {
                            <div class="rounded-3 bg-light border p-3 mb-4">
                                <div class="small text-muted">Kiválasztott terem</div>
                                <div class="fs-5 fw-bold text-break">@SelectedRoom.DisplayName</div>
                                <div class="small text-muted">@SelectedRoom.Building • @SelectedRoom.Floor</div>
                            </div>

                            <div class="fw-semibold small mb-2">1. Mai foglalás kiválasztása</div>
                            <div class="d-grid gap-2 mb-4">
                                @foreach (JanitorReservation reservation in SelectedRoom.Reservations)
                                {
                                    <button type="button"
                                            class="btn text-start @(selectedReservationId == reservation.ReservationId ? "btn-primary" : "btn-outline-secondary")"
                                            disabled="@isBusy"
                                            aria-pressed="@(selectedReservationId == reservation.ReservationId)"
                                            @onclick="() => SelectReservation(reservation.ReservationId)">
                                        <span class="d-block fw-semibold">@reservation.StartTime.ToString("HH:mm")–@reservation.EndTime.ToString("HH:mm")</span>
                                        <span class="d-block small text-break">@reservation.ParticipantName</span>
                                        <span class="d-block small">@GetReservationStatus(reservation)</span>
                                    </button>
                                }
                            </div>

                            @if (SelectedReservation is null)
                            {
                                <div class="alert alert-light border small mb-0">
                                    Válassz foglalást a megfelelő oktató és időpont megtekintéséhez.
                                </div>
                            }
                            else
                            {
                                <div class="rounded-3 border p-3 mb-3 small">
                                    <div><strong>Oktató:</strong> @SelectedReservation.ParticipantName</div>
                                    <div><strong>Időpont:</strong> @SelectedReservation.StartTime.ToString("yyyy.MM.dd. HH:mm") – @SelectedReservation.EndTime.ToString("HH:mm")</div>
                                </div>

                                @if (AlreadyHasRoomKey(SelectedReservation))
                                {
                                    <div class="alert alert-warning small">
                                        Az oktatónál már van olyan kulcs (akár Master), amely nyitja ezt a termet.
                                        Második kulcs csak a meglévő visszavétele után adható ki.
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-light border small">
                                        Ehhez a foglaláshoz a megfelelő, szabad kulcs bármikor kiadható.
                                    </div>
                                }

                                <div class="fw-semibold small mb-2">2. Hozzárendelt kulcs kiválasztása</div>
                                @if (SelectedKeys.Count == 0)
                                {
                                    <div class="alert alert-info small">
                                        Ehhez a teremhez az oktató jogosultságaival nem található kiadható kulcs.
                                        Ellenőrizd a kulcs terem- és szerepkör-hozzárendeléseit.
                                    </div>
                                }
                                else
                                {
                                    <div class="d-grid gap-2 mb-4">
                                        @foreach (JanitorKeyOption key in SelectedKeys)
                                        {
                                            <button type="button"
                                                    class="btn text-start d-flex align-items-center justify-content-between gap-2 @(selectedKeyId == key.KeyId ? "btn-primary" : "btn-outline-secondary")"
                                                    disabled="@(isBusy || IsIssued(key.KeyId) || AlreadyHasRoomKey(SelectedReservation))"
                                                    @onclick="() => SelectKey(key.KeyId)">
                                                <span class="text-break">@key.KeyName</span>
                                                <span class="small text-nowrap">@(IsIssued(key.KeyId) ? "Kiadva" : AlreadyHasRoomKey(SelectedReservation) ? "Már van kulcsa" : "Szabad")</span>
                                            </button>
                                        }
                                    </div>
                                }

                                <button type="button" class="btn btn-primary w-100 py-2 fw-semibold"
                                        disabled="@(!CanIssue)" @onclick="IssueAsync">
                                    @(isBusy ? "Feldolgozás..." : "Kulcs kiadása")
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Valódi aktív kulcstranzakciók -->
        <div class="card border-0 shadow-sm mt-4" id="active-issues">
            <div class="card-header bg-white border-bottom p-3 p-lg-4">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div>
                        <h5 class="fw-bold mb-1">Kiadott kulcsok</h5>
                        <p class="text-muted small mb-0">A ténylegesen rögzített, még vissza nem vett kulcsok.</p>
                    </div>
                    <span class="badge bg-secondary-subtle text-secondary-emphasis">@activeIssues.Count aktív</span>
                </div>
            </div>
            <div class="card-body p-0">
                @if (activeIssues.Count == 0)
                {
                    <div class="p-4 text-muted">Jelenleg nincs kiadott kulcs.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Kulcs</th>
                                    <th>Átvevő</th>
                                    <th>Kiadva (UTC)</th>
                                    <th class="text-end pe-4">Művelet</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (ActiveKeyIssue issue in activeIssues)
                                {
                                    <tr @key="issue.TransactionId">
                                        <td class="ps-4 fw-semibold">@issue.KeyName</td>
                                        <td>@issue.ParticipantName</td>
                                        <td>@issue.IssuedAtUtc.ToString("yyyy.MM.dd. HH:mm")</td>
                                        <td class="text-end pe-4">
                                            <button type="button" class="btn btn-sm btn-outline-success"
                                                    disabled="@isBusy" @onclick="() => ReturnAsync(issue.KeyId)">
                                                Visszavétel
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private sealed record RoomOption(
        Guid RoomId,
        string FullName,
        string Building,
        string Floor,
        string DisplayName,
        List<JanitorReservation> Reservations,
        List<Guid> KeyIds);

    private const int PageSize = 9;

    private List<JanitorReservation> todaysReservations = [];
    private List<ActiveKeyIssue> activeIssues = [];
    private List<RoomOption> roomCards = [];
    private HashSet<Guid> issuedKeyIds = [];

    private string searchText = string.Empty;
    private string selectedBuilding = string.Empty;
    private string selectedFloor = string.Empty;
    private bool onlyAvailable;
    private int currentPage = 1;

    private Guid? selectedRoomId;
    private Guid? selectedReservationId;
    private Guid? selectedKeyId;

    private bool isLoading = true;
    private bool isBusy;
    private bool lastSuccess;
    private string? message;

    // // Tesztórához
    // private DateTime debugLocalDateTime = DateTime.Today.AddDays(1).AddHours(10);

    private List<string> BuildingOptions => roomCards
        .Select(room => room.Building)
        .Distinct(StringComparer.CurrentCultureIgnoreCase)
        .OrderBy(building => building, StringComparer.CurrentCultureIgnoreCase)
        .ToList();

    private List<string> FloorOptions => roomCards
        .Where(room => selectedBuilding.Length == 0 || room.Building == selectedBuilding)
        .Select(room => room.Floor)
        .Distinct(StringComparer.CurrentCultureIgnoreCase)
        .OrderBy(floor => floor, StringComparer.CurrentCultureIgnoreCase)
        .ToList();

    private List<RoomOption> FilteredRooms => roomCards
        .Where(room => (selectedBuilding.Length == 0 || room.Building == selectedBuilding)
            && (selectedFloor.Length == 0 || room.Floor == selectedFloor)
            && (!onlyAvailable || AvailableKeysForRoom(room) > 0)
            && (string.IsNullOrWhiteSpace(searchText)
                || room.FullName.Contains(searchText.Trim(), StringComparison.CurrentCultureIgnoreCase)
                || room.Reservations.Any(reservation =>
                    reservation.ParticipantName.Contains(searchText.Trim(), StringComparison.CurrentCultureIgnoreCase)
                    || reservation.Keys.Any(key => key.KeyName.Contains(searchText.Trim(), StringComparison.CurrentCultureIgnoreCase)))))
        .ToList();

    private int PageCount => Math.Max(1, (FilteredRooms.Count + PageSize - 1) / PageSize);

    private List<RoomOption> PagedRooms => FilteredRooms
        .Skip((Math.Clamp(currentPage, 1, PageCount) - 1) * PageSize)
        .Take(PageSize)
        .ToList();

    private RoomOption? SelectedRoom => roomCards
        .FirstOrDefault(room => room.RoomId == selectedRoomId);

    private JanitorReservation? SelectedReservation => SelectedRoom?.Reservations
        .FirstOrDefault(reservation => reservation.ReservationId == selectedReservationId);

    private List<JanitorKeyOption> SelectedKeys => SelectedReservation?.Keys ?? [];

    private bool CanIssue => !isBusy
        && SelectedReservation is JanitorReservation reservation
        && !AlreadyHasRoomKey(reservation)
        && selectedKeyId is Guid keyId
        && !IsIssued(keyId)
        && reservation.Keys.Any(key => key.KeyId == keyId);

    private int AvailableKeyCount => roomCards
        .SelectMany(room => room.KeyIds)
        .Distinct()
        .Count(keyId => !IsIssued(keyId));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ReloadAsync();
        }
        catch (Exception)
        {
            message = "Az adatok betöltése sikertelen. Ellenőrizd az adatbázist.";
            lastSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static RoomOption ToRoomOption(IGrouping<Guid, JanitorReservation> group)
    {
        JanitorReservation first = group.First();
        return new RoomOption(
            group.Key,
            $"{first.Building} / {first.Floor} / {first.RoomName}",
            first.Building,
            first.Floor,
            first.RoomName,
            group.OrderBy(reservation => reservation.StartTime).ToList(),
            first.RoomKeyIds);
    }

    // Fizikai kulcskészlet szerinti teremstátusz, nem teremfoglaltság.
    // Például az I0-hoz kiadott Master kulcs a PC0-nál is kiadott kulcsnak
    // számít, mert azt IS nyitja. Ez nem jelenti, hogy a PC0 használatban van.
    private enum RoomKeyStatus { NoKeys, Free, PartiallyIssued, AllIssued }

    private RoomKeyStatus GetRoomKeyStatus(RoomOption room)
    {
        if (room.KeyIds.Count == 0)
        {
            return RoomKeyStatus.NoKeys;
        }

        int issuedCount = room.KeyIds.Count(IsIssued);
        if (issuedCount == 0)
        {
            return RoomKeyStatus.Free;
        }

        return issuedCount == room.KeyIds.Count
            ? RoomKeyStatus.AllIssued
            : RoomKeyStatus.PartiallyIssued;
    }

    private static string GetRoomStatusLabel(RoomKeyStatus status) => status switch
    {
        RoomKeyStatus.Free => "Minden kulcs szabad",
        RoomKeyStatus.PartiallyIssued => "Részben kiadott",
        RoomKeyStatus.AllIssued => "Nincs szabad kulcs",
        _ => "Nincs hozzárendelt kulcs"
    };

    private static string GetRoomStatusBadgeClass(RoomKeyStatus status) => status switch
    {
        RoomKeyStatus.Free => "bg-success-subtle text-success-emphasis",
        RoomKeyStatus.PartiallyIssued => "bg-warning-subtle text-warning-emphasis",
        RoomKeyStatus.AllIssued => "bg-danger-subtle text-danger-emphasis",
        _ => "bg-secondary-subtle text-secondary-emphasis"
    };

    // Egy oktatónál legfeljebb egy, az adott termet nyitó fizikai kulcs lehet.
    // Egy Master kulcs több teremet is nyithat, de ettől még egyetlen
    // kiadott kulcs, és az átvevője minden teremre ugyanaz marad.
    private bool AlreadyHasRoomKey(JanitorReservation? reservation) => reservation is not null
        && activeIssues.Any(issue => issue.ParticipantId == reservation.ParticipantId
            && issue.AssignedRoomIds.Contains(reservation.RoomId));

    // Az állapotot a szabad kulcsok alapján mutatjuk, nem a foglalás időpontja szerint.
    private string GetReservationStatus(JanitorReservation reservation)
    {
        if (AlreadyHasRoomKey(reservation))
        {
            return "Az oktatónál már van kulcs ehhez a teremhez";
        }
        if (reservation.Keys.Count == 0)
        {
            return "Nincs jogosultan átvehető kulcs";
        }
        return reservation.Keys.Any(key => !IsIssued(key.KeyId))
            ? "Van szabad kulcs"
            : "Minden kapcsolódó kulcs kiadva";
    }

    private bool IsIssued(Guid keyId)
    {
        return issuedKeyIds.Contains(keyId);
    }

    private int AvailableKeysForRoom(RoomOption room) => room.KeyIds
        .Count(keyId => !IsIssued(keyId));

    private int IssuedKeysForRoom(RoomOption room) => room.KeyIds
        .Count(IsIssued);

    // A tesztidő váltásakor a korábbi terem-, foglalás- és kulcskijelölés
    // már másik naphoz tartozhat, ezért töröljük a korábbi választásokat.
    private void ResetSelectionForClockChange()
    {
        selectedRoomId = null;
        selectedReservationId = null;
        selectedKeyId = null;
        selectedBuilding = string.Empty;
        selectedFloor = string.Empty;
        onlyAvailable = false;
        currentPage = 1;
    }

