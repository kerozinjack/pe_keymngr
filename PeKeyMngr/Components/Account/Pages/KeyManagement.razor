@page "/keymanagement"
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using PeKeyMngr.Data
@attribute [Authorize(Policy = "CanAccessJanitorPages")]
@inject KeyManagementService KeyService
@inject AuthenticationStateProvider AuthenticationStateProvider
@* A tesztóra injektálása átmenetileg kikapcsolva. *@
@* @inject JanitorTestClock TestClock *@

<PageTitle>Kulcskiadás és visszavétel</PageTitle>

<div class="container-fluid py-4 px-3 px-lg-4">
    <!-- Fejléc -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Kulcskiadás és visszavétel</h3>
            <p class="text-muted mb-0">Az aktuális nap valódi foglalásai, kulcskiadás és visszavétel.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="#active-issues" class="btn btn-outline-secondary">Kiadott kulcsok</a>
            <button type="button" class="btn btn-outline-primary" disabled="@(isLoading || isBusy)" @onclick="RefreshAsync">
                Adatok frissítése
            </button>
        </div>
    </div>


    @* Fejlesztői tesztpanel – Production környezetben nem jelenik meg. *@
    @*
