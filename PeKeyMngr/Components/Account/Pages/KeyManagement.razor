    private void OnSearchChanged(ChangeEventArgs args)
    {
        searchText = args.Value?.ToString() ?? string.Empty;
        currentPage = 1;
    }

    private void OnBuildingChanged(ChangeEventArgs args)
    {
        selectedBuilding = args.Value?.ToString() ?? string.Empty;
        selectedFloor = string.Empty;
        currentPage = 1;
    }

    private void SelectFloor(string floor)
    {
        selectedFloor = floor;
        currentPage = 1;
    }

    private void OnOnlyAvailableChanged(ChangeEventArgs args)
    {
        onlyAvailable = args.Value is bool value && value;
        currentPage = 1;
    }

    private void PreviousPage()
    {
        currentPage = Math.Max(1, currentPage - 1);
    }

    private void NextPage()
    {
        currentPage = Math.Min(PageCount, currentPage + 1);
    }

    private void SelectRoom(Guid roomId)
    {
        if (isBusy)
        {
            return;
        }
        selectedRoomId = roomId;
        selectedReservationId = null;
        selectedKeyId = null;
        message = null;
    }

    private void SelectReservation(Guid reservationId)
    {
        if (isBusy)
        {
            return;
        }
        selectedReservationId = reservationId;
        selectedKeyId = null;
        message = null;
    }

    private void SelectKey(Guid keyId)
    {
        if (isBusy || IsIssued(keyId) || !CanSelectKey(keyId) ||
            (SelectedReservation is JanitorReservation reservation && AlreadyHasRoomKey(reservation)))
        {
            return;
        }
        selectedKeyId = keyId;
    }

    private bool CanSelectKey(Guid keyId)
    {
        return SelectedReservation is JanitorReservation reservation
            && reservation.Keys.Any(key => key.KeyId == keyId);
    }

    private async Task<string?> CurrentUserIdAsync()
    {
        AuthenticationState auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
    }

    // Újratöltés: a portásoldal minden adatot frissen kér le az adatbázisból.
    private async Task ReloadAsync()
    {
        todaysReservations = await KeyService.GetTodayReservationsAsync();
        activeIssues = await KeyService.GetActiveIssuesAsync();
        issuedKeyIds = activeIssues.Select(issue => issue.KeyId).ToHashSet();

        roomCards = todaysReservations
            .GroupBy(reservation => reservation.RoomId)
            .Select(ToRoomOption)
            .OrderBy(room => room.Building)
            .ThenBy(room => room.Floor)
            .ThenBy(room => room.DisplayName)
            .ToList();

        if (SelectedRoom is null)
        {
            selectedRoomId = null;
            selectedReservationId = null;
            selectedKeyId = null;
        }
        else if (SelectedReservation is null)
        {
            selectedReservationId = null;
            selectedKeyId = null;
        }
        else if (selectedKeyId is Guid keyId &&
            (IsIssued(keyId) ||
             AlreadyHasRoomKey(SelectedReservation) ||
             !SelectedKeys.Any(key => key.KeyId == keyId)))
        {
            selectedKeyId = null;
        }

        currentPage = Math.Clamp(currentPage, 1, PageCount);
    }

    private async Task RefreshAsync()
    {
        if (isBusy)
        {
            return;
        }
        isBusy = true;
        try
        {
            await ReloadAsync();
            message = null;
        }
        catch (Exception)
        {
            lastSuccess = false;
            message = "A frissítés nem sikerült.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task IssueAsync()
    {
        JanitorReservation? reservation = SelectedReservation;
        Guid? keyId = selectedKeyId;
        if (!CanIssue || reservation is null || keyId is null)
        {
            return;
        }

        isBusy = true;
        try
        {
            KeyOperationResult result = await KeyService.IssueAsync(
                reservation.ReservationId, keyId.Value, await CurrentUserIdAsync());
            lastSuccess = result.Success;
            message = result.Message;
            if (result.Success)
            {
                selectedKeyId = null;
            }
            await ReloadAsync();
        }
        catch (Exception)
        {
            lastSuccess = false;
            message = "A kulcskiadás nem sikerült. Próbáld újra, vagy ellenőrizd az adatbázist.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ReturnAsync(Guid keyId)
    {
        if (isBusy)
        {
            return;
        }
        isBusy = true;
        try
        {
            KeyOperationResult result = await KeyService.ReturnAsync(keyId, await CurrentUserIdAsync());
            lastSuccess = result.Success;
            message = result.Message;
            await ReloadAsync();
        }
        catch (Exception)
        {
            lastSuccess = false;
            message = "A kulcs visszavétele nem sikerült. Próbáld újra.";
        }
        finally
        {
            isBusy = false;
        }
    }
