<StatusMessage Message="@StatusMessage" />
<h3>Helyreállítási kódok</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <strong>Ezeket a kódokat biztonságos helyen tárolja.</strong>
    </p>
    <p>
        Ha elveszíti az eszközét, és nincs helyreállítási kódja, akkor elveszíti a hozzáférést a fiókjához.
    </p>
</div>
<div class="row">
    <div class="col-md-12">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <div>
                <code class="recovery-code">@recoveryCode</code>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
