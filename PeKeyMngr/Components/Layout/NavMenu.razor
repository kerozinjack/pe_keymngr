@implements IDisposable

@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">PE-KEYMNGR</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        @* Base menu item visible to everyone *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Kezdőlap
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                @* Only users with the Admin role can see these menu items *@
                <AuthorizeView Policy="CanAccessAdminPages" Context="adminContext">
                    <Authorized>
                        <div class="nav-item px-3">
                            <span class="nav-link text-uppercase small fw-bold">Adminisztráció</span>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="rooms">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Termek
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="equipment">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Felszerelések
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="keys">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Kulcsok
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="maintenancewindows">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Karbantartások
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="roles">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Szerepkörök
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
                @* Only users with the Teacher role can see these menu items *@
                <AuthorizeView Policy="CanTeacherAdminPages" Context="teacherContext">
                    <Authorized>
                        <div class="nav-item px-3">
                            <span class="nav-link text-uppercase small fw-bold">Oktatói funkciók</span>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="reservations">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Foglalások
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
                @* Only users with the Operations Director role can see these menu items *@
                <AuthorizeView Policy="CanAccessOperationsDirectorPages" Context="operationsContext">
                    <Authorized>
                        <div class="nav-item px-3">
                            <span class="nav-link text-uppercase small fw-bold">Üzemeltetés</span>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="auditlogs">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Auditnapló
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
                @* Visible to all authenticated users *@
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="issuetickets">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Hibajegyek
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="auth">
                        <span class="bi bi-lock-nav-menu" aria-hidden="true"></span> Autentikáció
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> @context.User.Identity?.Name
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link text-danger">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Kijelentkezés
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                @* Visible only to users who are not signed in *@
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Regisztráció
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Bejelentkezés
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
