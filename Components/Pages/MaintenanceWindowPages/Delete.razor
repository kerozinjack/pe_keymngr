@page "/maintenancewindows/delete"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Models
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@attribute [Authorize]

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>MaintenanceWindow</h2>
    <hr />
    @if (maintenancewindow is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">StartTime</dt>
            <dd class="col-sm-10">@maintenancewindow.StartTime</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">EndTime</dt>
            <dd class="col-sm-10">@maintenancewindow.EndTime</dd>
        </dl>
        <EditForm method="post" Model="maintenancewindow" OnValidSubmit="DeleteMaintenanceWindow" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(maintenancewindow is null)">Delete</button> |
            <a href="/maintenancewindows">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private MaintenanceWindow? maintenancewindow;

    [SupplyParameterFromQuery]
    private Guid MaintenanceWindowId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        maintenancewindow = await context.MaintenanceWindows.FirstOrDefaultAsync(m => m.MaintenanceWindowId == MaintenanceWindowId);

        if (maintenancewindow is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteMaintenanceWindow()
    {
        using var context = DbFactory.CreateDbContext();
        context.MaintenanceWindows.Remove(maintenancewindow!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/maintenancewindows");
    }
}
