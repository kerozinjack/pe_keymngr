@page "/issuetickets/delete"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Models
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@attribute [Authorize]

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>IssueTicket</h2>
    <hr />
    @if (issueticket is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Timestamp</dt>
            <dd class="col-sm-10">@issueticket.Timestamp</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">IssueDescription</dt>
            <dd class="col-sm-10">@issueticket.IssueDescription</dd>
        </dl>
        <EditForm method="post" Model="issueticket" OnValidSubmit="DeleteIssueTicket" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(issueticket is null)">Delete</button> |
            <a href="/issuetickets">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private IssueTicket? issueticket;

    [SupplyParameterFromQuery]
    private Guid TicketId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        issueticket = await context.IssueTickets.FirstOrDefaultAsync(m => m.TicketId == TicketId);

        if (issueticket is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteIssueTicket()
    {
        using var context = DbFactory.CreateDbContext();
        context.IssueTickets.Remove(issueticket!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/issuetickets");
    }
}
