@page "/keys/delete"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using PeKeyMngr.Models
@inject IDbContextFactory<PeKeyMngr.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

@attribute [Authorize]

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Key</h2>
    <hr />
    @if (key is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">RoomName</dt>
            <dd class="col-sm-10">@key.KeyName</dd>
        </dl>
        <EditForm method="post" Model="key" OnValidSubmit="DeleteKey" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(key is null)">Delete</button> |
            <a href="/keys">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Key? key;

    [SupplyParameterFromQuery]
    private Guid KeyId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        key = await context.Keys.FirstOrDefaultAsync(m => m.KeyId == KeyId);

        if (key is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteKey()
    {
        using var context = DbFactory.CreateDbContext();
        context.Keys.Remove(key!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/keys");
    }
}
